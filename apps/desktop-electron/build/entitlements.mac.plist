<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Electron's V8 writes and executes JIT pages. Without these the renderer
         crashes on launch under the hardened runtime, not at build time. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- CuePoint spawns two sidecars: the PyInstaller engine and mpv. The
         PyInstaller bootloader re-execs itself through dyld variables, and mpv
         loads the dylibs shipped inside its own .app bundle. Library validation
         would reject both, since they are not part of this bundle's signature
         lineage even after we re-sign them. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
