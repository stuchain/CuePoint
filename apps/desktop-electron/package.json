{
  "name": "@cuepoint/desktop-electron",
  "private": true,
  "version": "1.0.0-test.1",
  "type": "module",
  "description": "CuePoint Electron shell workspace (renderer + main process)",
  "repository": {
    "type": "git",
    "url": "https://github.com/stuchain/CuePoint.git"
  },
  "main": "electron-dist/main.mjs",
  "scripts": {
    "dev:renderer": "npm run dev --prefix renderer",
    "build:renderer": "npm run build --prefix renderer",
    "build:electron": "node build/buildElectron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "build:engine-sidecar": "python ../../scripts/build_engine_sidecar.py",
    "fetch:player-sidecar": "python ../../scripts/fetch_player_sidecar.py",
    "verify:player-sidecar": "python ../../scripts/fetch_player_sidecar.py --verify-only",
    "pack:full": "npm run build:engine-sidecar && npm run fetch:player-sidecar && npm run pack",
    "storybook": "npm run storybook --prefix renderer",
    "dev": "npm run dev:renderer",
    "electron:dev": "npm run build:electron && cross-env NODE_ENV=development electron .",
    "electron:start": "npm run build && cross-env NODE_ENV=production electron .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "package": "electron-builder"
  },
  "build": {
    "appId": "com.cuepoint.desktop",
    "productName": "CuePoint",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-dist/**/*",
      "!electron-dist/**/*.map",
      "renderer/dist/**/*",
      "!renderer/dist/**/*.map",
      "!**/node_modules/**/*.map",
      "electron/preload.cjs",
      "package.json",
      {
        "from": "node_modules/@sentry/browser-utils",
        "to": "node_modules/@sentry/browser-utils",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "resources/engine/${os}-${arch}",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/player/${os}-${arch}",
        "to": "player",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "afterPack": "build/signNestedBinaries.cjs",
    "afterSign": "build/notarize.cjs",
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.music",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "CuePoint does not record audio. macOS asks for this because the bundled mpv player links the system audio frameworks.",
        "NSAppleEventsUsageDescription": "CuePoint does not script other applications."
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icons"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@sentry/cli": "3.8.0",
    "cross-env": "^7.0.3",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "typescript": "~5.7.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@sentry/electron": "7.20.1"
  }
}
