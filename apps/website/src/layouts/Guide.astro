---
/**
 * A page of the user guide (SITE-09), inside Page.astro. The shell of a document:
 *   - the search box at the top of the reading column, where a reader looks first;
 *   - every guide page in order, in a sidebar on a wide screen (a fold on a phone);
 *   - "On this page", a sticky rail on the right from 80rem up, and a fold above the page below that;
 *   - the page, at the reading measure, then "Edit this page on GitHub" and previous/next.
 * The Markdown goes in the slot. Only the article carries data-pagefind-body, so Pagefind indexes the
 * guide's text and not the sidebar or the search results. Each page is a TechArticle in JSON-LD.
 */
import { SITE_URL } from "../../site.config";
import { ogImagePath } from "../../scripts/og-path.mjs";
import GuideSearch from "../components/GuideSearch.astro";
import { GUIDE_ROWS, guidePath, guideSections, guideSlug, neighbours, type GuideRow } from "../content/guide";
import { GITHUB_BRANCH, GITHUB_URL, PUBLISHER, SITE_NAME } from "../data/site";
import { needsToc, tocEntries } from "../lib/toc";
import { canonicalFor, hrefFor } from "../lib/url";
import Page from "./Page.astro";

interface Props {
  row: GuideRow;
  /** The Markdown headings of the page (depth, slug, text), from Astro's render. */
  headings: readonly { depth: number; slug: string; text: string }[];
}
const { row, headings } = Astro.props;

const path = guidePath(guideSlug(row.file));
const toc = tocEntries(headings);
const showToc = needsToc(toc);
const { previous, next } = neighbours(row.file, GUIDE_ROWS);
const editUrl = `${GITHUB_URL}/edit/${GITHUB_BRANCH}/docs/user-guide/${row.file}`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: row.title,
    description: row.description,
    url: canonicalFor(path),
    mainEntityOfPage: canonicalFor(path),
    image: new URL(ogImagePath(path), SITE_URL).href,
    inLanguage: "en",
    about: { "@type": "Thing", name: SITE_NAME },
    author: { "@type": "Person", name: PUBLISHER },
    publisher: { "@type": "Person", name: PUBLISHER },
    isPartOf: { "@type": "CreativeWork", name: "CuePoint user guide", url: canonicalFor("guide/") },
  },
];
---

<Page
  title={`${row.title} | CuePoint guide`}
  description={row.description}
  path={path}
  schema={schema}
  breadcrumbs={[
    { label: "Home", path: "" },
    { label: "Guide", path: "guide/" },
    { label: row.title, path },
  ]}
>
  <div class:list={["guide", { "has-toc": showToc }]}>
    <div class="search">
      <GuideSearch />
    </div>

    <details class="pages" data-open-from="60rem">
      <summary>All guide pages</summary>
      <nav aria-label="Guide pages">
        {
          guideSections(GUIDE_ROWS).map((section) => (
            <div class="group">
              <p class="group-label">{section.label}</p>
              <ul>
                {section.pages.map((p) => (
                  <li>
                    <a class="page-link" href={hrefFor(guidePath(guideSlug(p.file)))} aria-current={p.file === row.file ? "page" : undefined}>
                      {p.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </details>

    {
      showToc && (
        <details class="toc" data-open-from="80rem" data-toc>
          <summary>On this page</summary>
          <nav aria-label="On this page">
            <p class="toc-label" aria-hidden="true">On this page</p>
            <ol>
              {toc.map((h) => (
                <li>
                  <a class="toc-link" href={`#${h.slug}`}>{h.text}</a>
                  {h.children.length > 0 && (
                    <ol>
                      {h.children.map((c) => (
                        <li>
                          <a class="toc-link" href={`#${c.slug}`}>{c.text}</a>
                        </li>
                      ))}
                    </ol>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        </details>
      )
    }

    <div class="main">
      <article class="prose" data-pagefind-body>
        <slot />
      </article>

      <p class="edit">
        <a href={editUrl} rel="noopener noreferrer">Edit this page on GitHub</a>
      </p>

      <nav class="pager" aria-label="Previous and next guide page">
        {
          previous ? (
            <a class="prev" href={hrefFor(guidePath(guideSlug(previous.file)))} rel="prev">
              <span class="dir">Previous</span>
              <span class="to">{previous.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a class="next" href={hrefFor(guidePath(guideSlug(next.file)))} rel="next">
              <span class="dir">Next</span>
              <span class="to">{next.title}</span>
            </a>
          )
        }
      </nav>
    </div>
  </div>
</Page>

<script>
  // The page list and the contents start folded, so on a phone the page comes first. From the width each
  // names (data-open-from) the CSS shows them whatever their state; this opens them too, for browsers
  // without ::details-content.
  document.querySelectorAll<HTMLDetailsElement>("details[data-open-from]").forEach((d) => {
    if (window.matchMedia(`(min-width: ${d.dataset["openFrom"]})`).matches) d.open = true;
  });

  // "On this page" marks the section being read: the last heading above the top fifth of the screen.
  const toc = document.querySelector<HTMLElement>("[data-toc]");
  if (toc) {
    const links = new Map([...toc.querySelectorAll<HTMLAnchorElement>("a[href^='#']")].map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const targets = [...links.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => el !== null);
    let current: HTMLAnchorElement | undefined;
    const mark = () => {
      const line = window.innerHeight * 0.2;
      let found: HTMLElement | undefined;
      for (const el of targets) {
        if (el.getBoundingClientRect().top <= line) found = el;
        else break;
      }
      const link = found ? links.get(found.id) : undefined;
      if (link === current) return;
      current?.removeAttribute("aria-current");
      link?.setAttribute("aria-current", "location");
      current = link;
    };
    let queued = false;
    window.addEventListener(
      "scroll",
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          mark();
        });
      },
      { passive: true },
    );
    mark();
  }
</script>

<style>
  /*
   * The grid: one column on a phone (search, pages, contents, the page, in that order); from 60rem the
   * pages are a sidebar; from 80rem "On this page" is a rail on the right. The reading column is capped at
   * the measure whatever the width.
   */
  .guide {
    display: grid;
    grid-template-areas: "search" "pages" "toc" "main";
    gap: var(--space-lg);
    width: min(100% - 2 * var(--gutter), var(--content-max));
    margin: var(--r1) auto var(--r2);
    align-items: start;
  }
  .search {
    grid-area: search;
  }
  .pages {
    grid-area: pages;
  }
  .toc {
    grid-area: toc;
  }
  .main {
    grid-area: main;
    min-width: 0;
  }
  .search :global(.gs) {
    max-width: var(--measure);
    margin-bottom: 0;
  }
  @media (min-width: 60rem) {
    .guide {
      grid-template-columns: 14rem minmax(0, 1fr);
      grid-template-areas: "pages search" "pages toc" "pages main";
      column-gap: var(--r3);
      row-gap: var(--space-lg);
    }
    .guide:not(.has-toc) {
      grid-template-areas: "pages search" "pages main";
    }
    .pages {
      position: sticky;
      top: calc(var(--header-h) + var(--space-lg));
      max-height: calc(100vh - var(--header-h) - 2 * var(--space-lg));
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .pages::details-content {
      content-visibility: visible;
      display: block;
    }
    /* open by force, so the fold control is not needed (and is not left as a dead tab stop) */
    .pages > summary {
      display: none;
    }
    .toc {
      max-width: var(--measure);
    }
  }
  @media (min-width: 80rem) {
    .guide.has-toc {
      grid-template-columns: 14rem minmax(0, 1fr) 13rem;
      grid-template-areas: "pages search toc" "pages main toc";
      column-gap: var(--r2);
    }
    .guide.has-toc .toc {
      position: sticky;
      top: calc(var(--header-h) + var(--space-lg));
      max-height: calc(100vh - var(--header-h) - 2 * var(--space-lg));
      overflow-y: auto;
      overscroll-behavior: contain;
      /* a rail, not a box: the page's own ground, a seam on its left */
      background: none;
      border: 0;
      border-left: var(--border-width) solid var(--border-outline);
      box-shadow: inset var(--border-width) 0 0 var(--border-muted);
    }
    .toc::details-content {
      content-visibility: visible;
      display: block;
    }
    .toc > summary {
      display: none;
    }
    .guide.has-toc .toc-label {
      display: block;
    }
    .guide.has-toc .toc nav {
      padding: var(--space-xs) 0 var(--space-lg) var(--space-lg);
    }
  }

  /* the folds and the sidebar: the app's panels */
  .pages,
  .toc {
    background: var(--bg-panel);
    border: var(--border-width) solid var(--border-outline);
    box-shadow: var(--shadow-bevel-panel);
  }
  summary {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 2.75rem;
    padding: var(--space-sm) var(--space-lg);
    font-family: var(--font-pixel);
    font-weight: 600;
    font-variant-ligatures: none;
    cursor: pointer;
  }
  .pages nav,
  .toc nav {
    padding: 0 var(--space-lg) var(--space-lg);
  }
  .pages nav {
    padding-top: var(--space-md);
  }
  .group + .group {
    margin-top: var(--space-lg);
  }
  .group-label,
  .toc-label {
    margin: 0 0 var(--space-xs);
    color: var(--fg-primary);
    font-family: var(--font-pixel);
    font-size: var(--font-size-sm);
    font-weight: 700;
    font-variant-ligatures: none;
  }
  .toc-label {
    display: none;
    margin-bottom: var(--space-sm);
  }
  ul,
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .page-link,
  .toc-link {
    display: block;
    padding: var(--space-xs) var(--space-sm);
    text-decoration: none;
    line-height: 1.35;
  }
  .page-link:hover,
  .toc-link:hover {
    color: var(--accent-primary-hover);
  }
  .page-link[aria-current="page"] {
    background: var(--accent-primary);
    color: var(--border-outline);
    font-weight: 700;
    box-shadow: var(--focus-halo), var(--shadow-bevel-sm);
  }
  .toc-link {
    font-size: var(--font-size-sm);
    border-left: 4px solid transparent;
  }
  .toc ol ol .toc-link {
    padding-left: calc(var(--space-sm) + var(--space-lg));
  }
  /* the section being read: a block of the accent on the rail's edge */
  .toc-link[aria-current="location"] {
    border-left-color: var(--accent-primary);
    font-weight: 700;
  }

  /* The Markdown is rendered outside this component's scope, hence :global. */
  .prose {
    max-width: var(--measure);
    line-height: 1.7;
  }
  .prose :global(h1) {
    margin: var(--space-md) 0 var(--r1);
  }
  /* the page's first paragraph is its lead */
  .prose > :global(h1 + p) {
    font-size: var(--t-lead);
    line-height: 1.5;
  }
  .prose :global(h2) {
    margin-top: var(--r3);
    padding-top: var(--r1);
    border-top: var(--border-width) solid var(--border-outline);
    box-shadow: inset 0 var(--border-width) 0 var(--border-muted);
  }
  .prose :global(h3) {
    margin-top: var(--r2);
  }
  .prose :global(h4) {
    margin-top: var(--r1);
  }
  /* inline padding grows the link's box without moving the lines: links in lists meet the 24 px target size */
  .prose :global(a) {
    padding-block: 0.2em;
  }
  .prose :global(li) {
    margin-bottom: var(--space-xs);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-xl);
  }
  .prose :global(pre) {
    margin: 0 0 var(--space-lg);
    padding: var(--space-md) var(--space-lg);
    overflow-x: auto;
    background: var(--bg-input);
    border: var(--border-width) solid var(--border-outline);
    box-shadow: var(--focus-halo), var(--shadow-inset-deep);
    font-size: var(--font-size-sm);
    line-height: 1.5;
  }
  .prose :global(pre code) {
    padding: 0;
    background: none;
    border: 0;
    font-size: inherit;
    overflow-wrap: normal;
  }
  .prose :global(blockquote) {
    margin: 0 0 var(--space-lg);
    padding: var(--space-md) var(--space-lg);
    background: var(--bg-panel);
    border: var(--border-width) solid var(--border-outline);
    box-shadow: var(--shadow-bevel-panel);
  }
  .prose :global(blockquote > :last-child) {
    margin-bottom: 0;
  }
  .prose :global(.scroll-x) {
    margin: 0 0 var(--space-lg);
    overflow-x: auto;
    border: var(--border-width) solid var(--border-outline);
    box-shadow: var(--focus-halo);
  }
  .prose :global(table) {
    border-collapse: collapse;
    min-width: 100%;
    font-size: var(--font-size-sm);
    line-height: 1.5;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-sm) var(--space-md);
    border: var(--hairline) solid var(--border-muted);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(thead th) {
    background: var(--bg-toolbar);
    font-weight: 700;
  }
  .prose :global(hr) {
    margin-block: var(--r2);
  }

  .edit {
    max-width: var(--measure);
    margin: var(--r2) 0 var(--r1);
    padding-top: var(--r1);
    border-top: var(--border-width) solid var(--border-outline);
    box-shadow: inset 0 var(--border-width) 0 var(--border-muted);
    font-size: var(--font-size-sm);
  }
  .edit a {
    display: inline-block;
    min-height: 1.5rem;
  }
  .pager {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-lg);
    max-width: var(--measure);
  }
  .pager a {
    display: block;
    padding: var(--space-md) var(--space-lg);
    background: var(--bg-panel);
    border: var(--border-width) solid var(--border-outline);
    box-shadow: var(--focus-halo), var(--shadow-bevel-panel), var(--shadow-badge);
    text-decoration: none;
    transition:
      translate var(--motion-quick) steps(2, end),
      box-shadow var(--motion-quick) steps(2, end);
  }
  .pager a:hover {
    translate: -2px -2px;
    box-shadow: var(--focus-halo), var(--shadow-bevel-panel), 4px 4px 0 var(--border-shadow);
  }
  .pager a:hover .to {
    color: var(--accent-primary-hover);
  }
  .pager a:active {
    translate: 2px 2px;
    box-shadow: var(--focus-halo), var(--shadow-bevel-pressed);
  }
  .pager .next {
    text-align: right;
  }
  .dir {
    display: block;
    color: var(--fg-primary);
    font-size: var(--font-size-sm);
  }
  .to {
    font-family: var(--font-pixel);
    font-size: var(--t-lead);
    font-weight: 600;
    font-variant-ligatures: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .pager a:hover,
    .pager a:active {
      translate: none;
    }
  }
</style>
