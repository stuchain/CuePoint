---
import { Font } from "astro:assets";
import { PUBLIC, SITE_URL } from "../../site.config";
import { ogImagePath } from "../../scripts/og-path.mjs";
import { neoDarkTokens } from "../../scripts/theme-colors.mjs";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_NAME } from "../data/site";
import { CSP } from "../lib/csp";
import { DEFAULT_THEME, themeInitScript } from "../lib/themes";
import { canonicalFor, hrefFor } from "../lib/url";
import type { PageProps } from "./Page.types";
import "../styles/tokens.generated.css";
import "../styles/global.css";

type Props = PageProps;

const { title, description, path, ogImage, ogPicture, schema = [], breadcrumbs, noindex, ogType = "website", publishedTime, tags = [] } = Astro.props as PageProps;

const canonical = canonicalFor(path);
// the browser's own chrome takes the header's color in the default theme (Neo Dark's toolbar token)
const THEME_COLOR = neoDarkTokens()["--bg-toolbar"];
// the 404 is served at any address, so it names no canonical address (check-site allows that)
const has404 = noindex === "404";
// Every page has its own sharing picture, drawn at build (scripts/og.mjs, SITE-11); `ogImage` overrides it.
const image = ogImage ?? { src: ogImagePath(path), width: 1200, height: 630 };
const imageUrl = new URL(image.src, SITE_URL).href;
const robots = !PUBLIC || noindex !== undefined ? "noindex, nofollow" : undefined;

const breadcrumbSchema =
  breadcrumbs && breadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbs.map((crumb, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: crumb.label,
          item: canonicalFor(crumb.path),
        })),
      }
    : undefined;
const jsonLd = [...schema, ...(breadcrumbSchema ? [breadcrumbSchema] : [])];
// "<" is escaped so a string in the data can never close the script tag
const toScript = (item: unknown) => JSON.stringify(item).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en" data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={CSP} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeInitScript()} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!has404 && <link rel="canonical" href={canonical} />}
    {robots && <meta name="robots" content={robots} />}
    <link rel="icon" type="image/svg+xml" href={hrefFor("icon.svg")} />
    <link rel="icon" sizes="any" href={hrefFor("favicon.ico")} />
    <meta name="theme-color" content={THEME_COLOR} />
    <link rel="apple-touch-icon" href={hrefFor("apple-touch-icon.png")} />
    <link rel="manifest" href={hrefFor("site.webmanifest")} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} blog`} href={hrefFor("blog/rss.xml")} />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    {ogType === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === "article" && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!has404 && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    {!ogImage && ogPicture && <meta name="og-picture" content={ogPicture.src} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <Font cssVariable="--font-pixelify" preload={[{ weight: "700" }, { weight: "600" }]} />
    <Font cssVariable="--font-prose" preload={[{ style: "normal" }]} />

    {jsonLd.map((item) => <script type="application/ld+json" set:html={toScript(item)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header currentPath={path} />
    <main id="main" tabindex="-1">
      {breadcrumbs && breadcrumbs.length > 0 && (
        <div class="crumbs-wrap"><Breadcrumbs items={breadcrumbs} /></div>
      )}
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .crumbs-wrap {
    width: min(100% - 2 * var(--gutter), var(--content-max));
    margin: var(--space-lg) auto 0;
  }
</style>
