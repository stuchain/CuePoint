---
/*
 * One feature page (SITE-08), at /features/<slug>/. Everything it says is in src/data/features.ts:
 * the problem in the DJ's words, how CuePoint solves it, the app's picture (a labelled placeholder until
 * SITE-04), what it does not do, the guide page, two related pages and the download.
 *
 * A page or a section for something the app does not ship yet shows a preview note and carries
 * `data-unshipped` (components/Unshipped.astro); a public build fails while any remains.
 *
 * Three pages open on a live pixel prop beside their intro, where a moving object says something (these
 * were on the home page until the owner moved the details here, 2026-10-09). The prop is decoration: the
 * text says it all, and where 3D does not run the prop is its still.
 */
import AppShot from "../components/AppShot.astro";
import HomeAction from "../components/HomeAction.astro";
import PageHead from "../components/PageHead.astro";
import Section from "../components/Section.astro";
import Unshipped from "../components/Unshipped.astro";
import AppNote from "../components/AppNote.astro";
import { featureHref } from "../data/features";
import Scene from "../components/Scene.astro";
import { featureBySlugFor } from "../i18n/content";
import { fmt } from "../i18n/format";
import { DEFAULT_HREFLANG, type LocaleCode } from "../i18n/locales";
import { leavesLanguage, localePath } from "../i18n/paths";
import { ui } from "../i18n/ui";
import Page from "../layouts/Page.astro";
import type { SceneName } from "../three/scenes";
import { guidePath } from "../content/guide";
import { hrefFor } from "../lib/url";

/** The page of a feature, in a language. The route files give each language its slugs (getStaticPaths there). */
interface Props {
  locale: LocaleCode;
  slug: string;
}
const { locale, slug } = Astro.props;
const t = ui(locale);
const page = featureBySlugFor(locale, slug);
if (!page) throw new Error(`No feature page "${slug}" in ${locale}`);
const related = page.related.map((s) => featureBySlugFor(locale, s)!);

/** The pages with a live prop, and what the prop shows. */
const PROPS: Partial<Record<string, { scene: SceneName; alt: string }>> = {
  clean: { scene: "record", alt: t.features.propAlt.clean },
  keys: { scene: "wheel", alt: t.features.propAlt.keys },
  waveforms: { scene: "terrain", alt: t.features.propAlt.waveforms },
};
const prop = PROPS[page.slug];
---

<Page
  title={page.title}
  description={page.description}
  path={featureHref(page.slug)}
  locale={locale}
  breadcrumbs={[
    { label: t.nav.home, path: "" },
    { label: t.nav.features, path: "features/" },
    { label: page.name, path: featureHref(page.slug) },
  ]}
>
  <PageHead title={page.heading}>
    {page.unshipped && <Unshipped step={page.unshipped.step} />}
    {page.problem.map((p) => <p>{p}</p>)}
    <AppNote />
    {
      prop && (
        <div slot="aside" class="prop">
          <Scene name={prop.scene} bare autostart priority alt={prop.alt} />
        </div>
      )
    }
  </PageHead>

  <Section id="how" heading={fmt(t.features.howTitle, { name: page.name })} layout="split">
    <div class="how">
      <div class="copy">
        {
          page.how.map((s) => (
            <section class="step">
              <h3>{s.heading}</h3>
              {s.unshipped && <Unshipped step={s.unshipped.step} />}
              {s.paragraphs.map((p) => <p>{p}</p>)}
            </section>
          ))
        }
      </div>
      <AppShot id={page.shot} />
    </div>
  </Section>

  <!-- secondary on purpose: smaller, quieter, after what it does -->
  <Section id="not" heading={t.features.notTitle} layout="split">
    <ul class="not">
      {page.doesNot.map((line) => <li>{line}</li>)}
    </ul>
  </Section>

  <Section id="next" heading={t.features.nextTitle} layout="split">
    <ul class="rows">
      {page.guide && <li><a class="row-name" href={hrefFor(guidePath(page.guide.page))} hreflang={leavesLanguage(locale, guidePath(page.guide.page)) ? DEFAULT_HREFLANG : undefined}>{page.guide.label}{leavesLanguage(locale, guidePath(page.guide.page)) && <span class="in-english"> ({t.inEnglish})</span>}</a><p>{t.features.guideNote}</p></li>}
      {
        related.map((r) => (
          <li>
            <a class="row-name" href={hrefFor(localePath(locale, featureHref(r.slug)))}>{r.name}</a>
            <p>{r.summary}</p>
          </li>
        ))
      }
      <li><a class="row-name" href={hrefFor(localePath(locale, "features/"))}>{t.features.allFeatures}</a><p>{t.features.allFeaturesNote}</p></li>
    </ul>
    <p class="action"><HomeAction /></p>
  </Section>
</Page>

<style>
  /* "(in English)" after a link into the guide, which has no translation */
  .in-english {
    color: var(--fg-muted);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: 400;
  }
  .prop {
    min-width: 0;
  }
  .step + .step {
    margin-top: var(--r2);
  }
  .step h3 {
    margin: 0 0 var(--space-md);
  }
  .step p {
    max-width: 34rem;
  }
  .how {
    display: grid;
    gap: var(--r2);
  }
  /* what it does not do: the page's quiet part, in a smaller size and the muted color */
  .not {
    max-width: 34rem;
    margin: 0;
    padding-left: var(--space-xl);
    color: var(--fg-muted);
    font-size: var(--font-size-sm);
  }
  .not li {
    margin-bottom: var(--space-sm);
  }
  .not li::marker {
    color: var(--border-highlight);
  }
  #not :global(h2) {
    font-size: var(--t-lead);
    color: var(--fg-muted);
  }
  .action {
    margin-top: var(--r2);
  }
</style>
