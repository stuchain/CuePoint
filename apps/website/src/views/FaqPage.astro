---
/**
 * /faq/: the questions a new visitor asks (SITE-09). The page and its FAQPage JSON-LD are both built
 * from src/content/faq.yaml. Every link into the guide is checked against the guide's headings, so a
 * renamed heading fails the build instead of leaving a dead link.
 */
import PageHead from "../components/PageHead.astro";
import { faqEntries } from "../i18n/faq-load";
import { fmt } from "../i18n/format";
import { DEFAULT_HREFLANG, type LocaleCode } from "../i18n/locales";
import { leavesLanguage } from "../i18n/paths";
import { rich } from "../i18n/rich";
import { ui } from "../i18n/ui";
import { faqSchema, paragraphs } from "../lib/faq";
import { guideLinkConfig } from "../lib/guide-config";
import { rewriteLink } from "../lib/guide-links";
import { join } from "node:path";
import Page from "../layouts/Page.astro";
import { hrefFor } from "../lib/url";

interface Props {
  locale: LocaleCode;
}
const { locale } = Astro.props;
const t = ui(locale);
const cfg = guideLinkConfig();
const entries = await faqEntries(locale);
const faqs = await Promise.all(
  entries.map(async (e) => ({
    id: e.id,
    question: e.question,
    answer: e.answer,
    links: await Promise.all(
      e.links.map(async (l) => ({
        label: l.label,
        // the same check the guide's own links get: the page and the heading must exist
        href: await rewriteLink(`${l.page}.md${l.heading ? `#${l.heading}` : ""}`, join(cfg.guideDir, "faq.md"), cfg),
      })),
    ),
  })),
);
---

<Page
  title={t.faq.title}
  description={t.faq.description}
  path="faq/"
  locale={locale}
  schema={[faqSchema(faqs)]}
  breadcrumbs={[
    { label: t.nav.home, path: "" },
    { label: t.nav.faq, path: "faq/" },
  ]}
>
  <PageHead title={t.faq.heading}>
    <p set:html={rich(t.faq.lead, { guide: { href: hrefFor("guide/"), hreflang: leavesLanguage(locale, "guide/") ? DEFAULT_HREFLANG : undefined } })} />
  </PageHead>

  <!-- every question at a glance; each one jumps to its answer (the ids are the FAQ's own, q-<id>) -->
  <nav class="jump" aria-labelledby="jump-heading">
    <h2 id="jump-heading" class="jump-heading">{t.faq.jumpTitle}</h2>
    <ol>
      {
        faqs.map((f) => (
          <li>
            <a href={`#q-${f.id}`}>{f.question}</a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="answers">
    {
      faqs.map((f) => (
        <section class="qa" aria-labelledby={`q-${f.id}`} data-reveal>
          <h2 id={`q-${f.id}`}>{f.question}</h2>
          <div class="answer">
            {paragraphs(f.answer).map((p) => (
              <p>{p}</p>
            ))}
            <ul class="more" aria-label={fmt(t.faq.moreAbout, { question: f.question })}>
              {f.links.map((l) => (
                <li>
                  <a href={l.href} hreflang={leavesLanguage(locale, "guide/") ? DEFAULT_HREFLANG : undefined}>{l.label}{leavesLanguage(locale, "guide/") && <span class="in-english"> ({t.inEnglish})</span>}</a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }
  </div>
</Page>

<style>
  /* "(in English)" after a link into the guide, which has no translation */
  .in-english {
    color: var(--fg-muted);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: 400;
  }
  .jump,
  .answers {
    width: min(100% - 2 * var(--gutter), var(--content-max));
    margin-inline: auto;
  }
  /* the questions, in one of the app's panels */
  .jump {
    margin-block: var(--r1) var(--r3);
    padding: var(--r1) var(--r2) var(--r2);
    background: var(--bg-panel);
    border: var(--border-width-heavy) solid var(--border-outline);
    box-shadow: var(--shadow-bevel-panel), var(--shadow-panel);
  }
  .jump-heading {
    margin: 0 0 var(--space-md);
    font-size: var(--t-lead);
  }
  .jump ol {
    margin: 0;
    padding-left: var(--space-xl);
    columns: 22rem 2;
    column-gap: var(--r2);
  }
  .jump li {
    break-inside: avoid;
    padding-block: var(--space-xs);
  }
  .jump a {
    display: inline-block;
    vertical-align: top;
    min-height: 1.5rem;
  }
  /* each question and its answer: a row on the app's seams, the question on the left on a wide screen */
  .qa {
    display: grid;
    gap: var(--space-md) var(--r3);
    padding-block: var(--r2);
    border-top: var(--border-width) solid var(--border-outline);
    box-shadow: inset 0 var(--border-width) 0 var(--border-muted);
  }
  .qa h2 {
    margin: 0;
    font-size: var(--t-lead);
    line-height: 1.25;
  }
  .answer {
    max-width: 36rem;
  }
  .answer p {
    margin: 0 0 var(--space-md);
  }
  .more {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    margin: var(--space-md) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--font-size-sm);
  }
  .more a {
    display: inline-block;
    min-height: 1.5rem;
  }
  @media (min-width: 60rem) {
    .qa {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      align-items: baseline;
    }
  }
</style>
