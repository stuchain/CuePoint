---
/**
 * /faq/: the questions a new visitor asks (SITE-09). The page and its FAQPage JSON-LD are both built
 * from src/content/faq.yaml. Every link into the guide is checked against the guide's headings, so a
 * renamed heading fails the build instead of leaving a dead link.
 */
import { getCollection } from "astro:content";
import PageHead from "../components/PageHead.astro";
import { faqSchema, paragraphs } from "../lib/faq";
import { guideLinkConfig } from "../lib/guide-config";
import { rewriteLink } from "../lib/guide-links";
import { join } from "node:path";
import Page from "../layouts/Page.astro";
import { hrefFor } from "../lib/url";

const cfg = guideLinkConfig();
const entries = (await getCollection("faq")).sort((a, b) => a.data.order - b.data.order);
const faqs = await Promise.all(
  entries.map(async (e) => ({
    id: e.id,
    question: e.data.question,
    answer: e.data.answer,
    links: await Promise.all(
      e.data.links.map(async (l) => ({
        label: l.label,
        // the same check the guide's own links get: the page and the heading must exist
        href: await rewriteLink(`${l.page}.md${l.heading ? `#${l.heading}` : ""}`, join(cfg.guideDir, "faq.md"), cfg),
      })),
    ),
  })),
);
---

<Page
  title="FAQ | CuePoint"
  description="Quick answers about CuePoint: whether it is free, what it does to your Rekordbox library, what it sends, how it updates and how to report a problem."
  path="faq/"
  schema={[faqSchema(faqs)]}
  breadcrumbs={[
    { label: "Home", path: "" },
    { label: "FAQ", path: "faq/" },
  ]}
>
  <PageHead title="Frequently asked questions">
    <p>Short answers first, with a link to the part of the <a href={hrefFor("guide/")}>user guide</a> that goes further.</p>
  </PageHead>

  <!-- every question at a glance; each one jumps to its answer (the ids are the FAQ's own, q-<id>) -->
  <nav class="jump" aria-labelledby="jump-heading">
    <h2 id="jump-heading" class="jump-heading">The questions</h2>
    <ol>
      {
        faqs.map((f) => (
          <li>
            <a href={`#q-${f.id}`}>{f.question}</a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="answers">
    {
      faqs.map((f) => (
        <section class="qa" aria-labelledby={`q-${f.id}`} data-reveal>
          <h2 id={`q-${f.id}`}>{f.question}</h2>
          <div class="answer">
            {paragraphs(f.answer).map((p) => (
              <p>{p}</p>
            ))}
            <ul class="more" aria-label={`More about: ${f.question}`}>
              {f.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }
  </div>
</Page>

<style>
  .jump,
  .answers {
    width: min(100% - 2 * var(--gutter), var(--content-max));
    margin-inline: auto;
  }
  /* the questions, in one of the app's panels */
  .jump {
    margin-block: var(--r1) var(--r3);
    padding: var(--r1) var(--r2) var(--r2);
    background: var(--bg-panel);
    border: var(--border-width-heavy) solid var(--border-outline);
    box-shadow: var(--shadow-bevel-panel), var(--shadow-panel);
  }
  .jump-heading {
    margin: 0 0 var(--space-md);
    font-size: var(--t-lead);
  }
  .jump ol {
    margin: 0;
    padding-left: var(--space-xl);
    columns: 22rem 2;
    column-gap: var(--r2);
  }
  .jump li {
    break-inside: avoid;
    padding-block: var(--space-xs);
  }
  .jump a {
    display: inline-block;
    vertical-align: top;
    min-height: 1.5rem;
  }
  /* each question and its answer: a row on the app's seams, the question on the left on a wide screen */
  .qa {
    display: grid;
    gap: var(--space-md) var(--r3);
    padding-block: var(--r2);
    border-top: var(--border-width) solid var(--border-outline);
    box-shadow: inset 0 var(--border-width) 0 var(--border-muted);
  }
  .qa h2 {
    margin: 0;
    font-size: var(--t-lead);
    line-height: 1.25;
  }
  .answer {
    max-width: 36rem;
  }
  .answer p {
    margin: 0 0 var(--space-md);
  }
  .more {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    margin: var(--space-md) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--font-size-sm);
  }
  .more a {
    display: inline-block;
    min-height: 1.5rem;
  }
  @media (min-width: 60rem) {
    .qa {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      align-items: baseline;
    }
  }
</style>
