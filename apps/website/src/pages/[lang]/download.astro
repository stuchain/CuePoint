---
import { OTHER_LOCALES, type LocaleCode } from "../../i18n/locales";
import DownloadPage from "../../views/DownloadPage.astro";

/** /<code>/download/ (DEC-312). */
export function getStaticPaths() {
  return OTHER_LOCALES.map((l) => ({ params: { lang: l.code }, props: { locale: l.code as LocaleCode } }));
}
const { locale } = Astro.props;
---

<DownloadPage locale={locale} />
