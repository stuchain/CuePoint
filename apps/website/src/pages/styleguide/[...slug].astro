---
/*
 * /styleguide/: every component in every theme, for review. Preview builds only.
 * It is a rest-parameter route so that getStaticPaths can return nothing in a public build:
 * the page is then not built at all (and the sitemap filter in astro.config.ts is the second guard).
 */
import { PUBLIC } from "../../../site.config";
import Badge from "../../components/Badge.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Button from "../../components/Button.astro";
import Callout from "../../components/Callout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import Img from "../../components/Img.astro";
import Kbd from "../../components/Kbd.astro";
import Panel from "../../components/Panel.astro";
import Section from "../../components/Section.astro";
import ogDefault from "../../assets/og/default.png";
import Page from "../../layouts/Page.astro";
import { THEMES } from "../../lib/themes";

export function getStaticPaths() {
  return PUBLIC ? [] : [{ params: { slug: undefined } }];
}
---

<Page
  title="Style guide"
  description="Every component of the CuePoint site, shown in each of the five themes, for review. Preview builds only."
  path="styleguide/"
  breadcrumbs={[
    { label: "Home", path: "" },
    { label: "Style guide", path: "styleguide/" },
  ]}
>
  <Section id="guide">
    <h1>Style guide</h1>
    <p>
      Every component in each of the app's five themes, each block pinned to one. The site itself wears
      only the first, Neo Dark.
    </p>
    <div class="themes">
      {
        THEMES.map((theme) => (
          <section class="theme" data-theme={theme.id} aria-labelledby={`t-${theme.id}`}>
            <h2 id={`t-${theme.id}`}>{theme.label}</h2>

            <h3>Buttons and badges</h3>
            <p class="row">
              <Button href="#guide">Primary link</Button>
              <Button>Primary button</Button>
              <Button variant="secondary">Secondary</Button>
              <Button variant="secondary" disabled>Disabled</Button>
            </p>
            <p class="row">
              <Badge>Neutral</Badge>
              <Badge variant="accent">Accent</Badge>
              <Badge variant="success">Success</Badge>
              <Badge variant="warning">Warning</Badge>
              <Badge variant="danger">Danger</Badge>
              <Badge variant="info">Info</Badge>
            </p>

            <h3>Panel</h3>
            <Panel>
              <p>A panel holds one idea. <a href="#guide">A link inside it</a> and a key: <Kbd>Ctrl</Kbd> + <Kbd>K</Kbd>.</p>
            </Panel>

            <h3>Callouts</h3>
            <div class="stack">
              <Callout title="Note">CuePoint keeps your own values over Rekordbox's.</Callout>
              <Callout kind="success" title="Done">Your library was exported.</Callout>
              <Callout kind="warning" title="Check first">Two tracks have no file on disk.</Callout>
              <Callout kind="danger" title="Could not read the file">Choose a Rekordbox XML export.</Callout>
            </div>

            <h3>Code</h3>
            <CodeBlock label="Terminal command" code={"cd CuePoint\nnpm run dev -- --host 0.0.0.0 --port 4321 --open-the-browser-when-it-is-ready"} />

            <h3>Image</h3>
            <Img src={ogDefault} alt="The CuePoint mark on a dark background" width={240} />

            <h3>Breadcrumbs</h3>
            <Breadcrumbs items={[{ label: "Home", path: "" }, { label: "Style guide", path: "styleguide/" }, { label: "Components", path: "styleguide/" }]} />

            <h3>Type</h3>
            <p class="small">Prose is set in Atkinson Hyperlegible Next. Muted text, on the page only: <span class="muted">Camelot 8A, 124 BPM</span>.</p>
          </section>
        ))
      }
    </div>
  </Section>
</Page>

<style>
  .themes {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .theme {
    min-width: 0;
    padding: var(--space-lg);
    background: var(--bg-app);
    color: var(--fg-primary);
    border: var(--border-width) solid var(--border-outline);
    box-shadow: var(--shadow-panel);
  }
  .theme > h2 {
    margin-top: 0;
  }
  .theme h3 {
    margin: var(--space-lg) 0 var(--space-sm);
    font-size: var(--font-size-md);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
  }
  .stack {
    display: grid;
    gap: var(--space-md);
  }
  .muted {
    color: var(--fg-muted);
  }
  .small {
    font-size: var(--font-size-sm);
  }
</style>
