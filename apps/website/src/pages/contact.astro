---
import Field from "../components/Field.astro";
import Form from "../components/Form.astro";
import PageHead from "../components/PageHead.astro";
import Section from "../components/Section.astro";
import { GITHUB_URL, SITE_NAME } from "../data/site";
import Page from "../layouts/Page.astro";
import { SUBJECTS } from "../lib/forms";
import { hrefFor } from "../lib/url";

/** /contact/: write to the publisher (SITE-12, DEC-143). Sends through Web3Forms (DEC-193). */
const subjects = SUBJECTS.map((s) => ({ value: s, label: s }));
---

<Page
  title="Contact"
  description="Write to the person who makes CuePoint: feedback, a question, or anything else. Your message goes to one inbox, and you get a reply by email."
  path="contact/"
  breadcrumbs={[{ label: "Home", path: "" }, { label: "Contact", path: "contact/" }]}
>
  <PageHead title="Contact">
    <p data-form-intro>
      Feedback, a question, or something else about {SITE_NAME}: write here and the message goes to one inbox. Found a bug? The{" "}
      <a href={hrefFor("report-a-bug/")}>bug report form</a> asks for the details that help.
    </p>
  </PageHead>

  <Section id="contact" layout="split">
    <div slot="aside" class="form-aside">
      <p>
        The form is the way to write to the publisher. It is sent through a service called Web3Forms; the{" "}
        <a href={hrefFor("privacy/#forms")}>privacy policy</a> says what it receives and keeps. You can also{" "}
        <a href={`${GITHUB_URL}/issues`} rel="noopener noreferrer">open an issue on GitHub</a>.
      </p>
    </div>
    <Form kind="contact" thanks="contact/thank-you/" send="Send message" noun="message">
      <Field id="name" label="Name (optional)" control="input" autocomplete="name" />
      <Field id="email" label="Email" control="input" type="email" required autocomplete="email" hint="Where the reply goes." />
      <Field id="subject" label="Subject" control="select" required options={subjects} />
      <Field id="message" label="Message" control="textarea" required rows={7} />
    </Form>
  </Section>
</Page>
