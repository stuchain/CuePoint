---
/*
 * /compare/ (SITE-08, DEC-197): the index of the comparison pages, and how they are written.
 */
import PageHead from "../../components/PageHead.astro";
import Section from "../../components/Section.astro";
import { COMPARE_CHECKED, COMPARE_TOOLS, compareHref } from "../../data/compare";
import Page from "../../layouts/Page.astro";
import { hrefFor } from "../../lib/url";
---

<Page
  title="CuePoint compared with other DJ tools"
  description="CuePoint next to Lexicon, Mixed In Key and OpenKeyScan: facts about each tool linked to its own page and dated, and what CuePoint does not do."
  path="compare/"
  breadcrumbs={[
    { label: "Home", path: "" },
    { label: "Compare", path: "compare/" },
  ]}
>
  <PageHead title="CuePoint compared with other tools">
    <p>
      DJs already use good tools to look after a library. These pages set CuePoint beside three of them, so you can see
      what each one does and pick the one that fits.
    </p>
  </PageHead>

  <Section id="compare" heading="The comparisons" layout="split">
    <ul class="rows">
      {
        COMPARE_TOOLS.map((t) => (
          <li>
            <a class="row-name" href={hrefFor(compareHref(t.slug))}>CuePoint and {t.name}</a>
            <p>{t.summary}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="how" heading="How these pages are written" layout="split">
    <ul class="how">
      <li>Every fact about another tool links the page of that tool it was read on, and says the date we read it.</li>
      <li>Every page says what CuePoint does not do.</li>
      <li>
        Tools change. These pages were last checked on <time datetime={COMPARE_CHECKED}>{COMPARE_CHECKED}</time>. If
        something is out of date, <a href={hrefFor("contact/")}>tell us</a> and we will fix it.
      </li>
    </ul>
  </Section>
</Page>

<style>
  .how {
    max-width: 34rem;
    margin: 0;
    padding-left: var(--space-xl);
  }
  .how li {
    margin-bottom: var(--space-sm);
  }
</style>
