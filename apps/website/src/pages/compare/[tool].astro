---
import { COMPARE_TOOLS } from "../../data/compare";
import ComparePage from "../../views/ComparePage.astro";

export function getStaticPaths() {
  return COMPARE_TOOLS.map((tool) => ({ params: { tool: tool.slug }, props: { slug: tool.slug } }));
}
const { slug } = Astro.props;
---

<ComparePage locale="en" slug={slug} />
