---
import { FEATURE_PAGES } from "../../data/features";
import FeaturePage from "../../views/FeaturePage.astro";

export function getStaticPaths() {
  return FEATURE_PAGES.map((page) => ({ params: { slug: page.slug }, props: { slug: page.slug } }));
}
const { slug } = Astro.props;
---

<FeaturePage locale="en" slug={slug} />
