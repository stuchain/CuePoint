---
/*
 * /features/ (SITE-08): the overview. One card for each feature page, the comparison pages below, and
 * a SoftwareApplication whose featureList names only what the app ships today (a feature marked
 * unshipped in src/data/features.ts is left out until its step ships it).
 */
import { SITE_URL } from "../../../site.config";
import HomeAction from "../../components/HomeAction.astro";
import PageHead from "../../components/PageHead.astro";
import Section from "../../components/Section.astro";
import Unshipped from "../../components/Unshipped.astro";
import { COMPARE_TOOLS, compareHref } from "../../data/compare";
import { FEATURE_PAGES, OVERVIEW, featureHref, shippedPages } from "../../data/features";
import { HERO } from "../../data/home";
import { SITE_NAME } from "../../data/site";
import Page from "../../layouts/Page.astro";
import { canonicalFor, hrefFor } from "../../lib/url";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: SITE_NAME,
    description: HERO.description,
    applicationCategory: "MultimediaApplication",
    operatingSystem: "Windows, macOS, Linux",
    url: SITE_URL,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    featureList: shippedPages().map((p) => `${p.name}: ${p.summary}`),
    mainEntityOfPage: canonicalFor("features/"),
  },
];
---

<Page
  title={OVERVIEW.title}
  description={OVERVIEW.description}
  path="features/"
  schema={schema}
  breadcrumbs={[
    { label: "Home", path: "" },
    { label: "Features", path: "features/" },
  ]}
>
  <PageHead title="What CuePoint does for your library">
    <p>
      CuePoint is a free desktop app that takes the collection you export from Rekordbox, matches it to Beatport and
      helps you keep it clean. Each part has its own page.
    </p>
  </PageHead>

  <Section id="list" heading="The features" layout="split">
    <ul class="rows">
      {
        FEATURE_PAGES.map((p) => (
          <li data-reveal>
            <h3 class="row-name">
              <a href={hrefFor(featureHref(p.slug))}>{p.name}</a>
            </h3>
            <div>
              <p>{p.summary}</p>
              {p.unshipped && <Unshipped step={p.unshipped.step} compact />}
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="compare" heading="Compared with other tools" layout="split">
    <p class="intro">
      Not sure CuePoint is the right tool? These pages set it beside others, with every fact about the other tool
      linked to its own page and dated.
    </p>
    <ul class="rows">
      {
        COMPARE_TOOLS.map((t) => (
          <li data-reveal>
            <a class="row-name" href={hrefFor(compareHref(t.slug))}>CuePoint and {t.name}</a>
            <p>{t.summary}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="get" heading="Get CuePoint" layout="split">
    <p class="get"><HomeAction /></p>
  </Section>
</Page>

<style>
  .intro {
    max-width: 34rem;
    margin: 0 0 var(--r2);
  }
  .rows :global([data-unshipped]) {
    margin-top: var(--space-xs);
  }
  .get :global([data-primary-action]) {
    font-size: var(--font-size-lg);
    padding: var(--space-md) calc(var(--space-xl) * 1.2);
  }
</style>
