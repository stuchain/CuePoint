---
import { PUBLIC } from "../../site.config";
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CuePoint</title>
    <meta
      name="description"
      content="CuePoint is a free desktop app for DJs that cleans up a Rekordbox library."
    />
    {!PUBLIC && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    <h1>CuePoint</h1>
    <p><a href={base}>Home</a></p>
  </body>
</html>
