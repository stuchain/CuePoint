---
/*
 * The home page (SITE-06): what CuePoint does for a DJ, in one screen; then the opening that shows it
 * (DEC-189: the crate becomes the wheel); then one section for each thing the app does, the reasons to
 * trust it, and the download.
 *
 * The opening is one full-screen scene, pinned (CSS sticky) for the whole of a tall section. Its first
 * screen is the hero: the headline over the scene, which moves on its own as soon as the page is idle
 * (Scene's `autostart`), fading in over its still. Scrolling drives the camera through the story, and a
 * track of three steps scrolls over it in big type. The scene's scroll range is that track (`trigger`,
 * from its top at the middle of the screen to its bottom at the middle), so each step, placed at the
 * middle of its span of src/three/phases.ts, is centered on the screen exactly while the scene shows what
 * it says. The steps say the whole story in words, so nothing is only in the 3D. In the last phase the
 * pinned scene hands over to the app window's slot, which rises flat out of the wheel (DEC-189).
 *
 * Where the 3D does not run:
 *   - with reduced motion, saveData, a small device or no WebGL 2 (known before first paint: the inline
 *     script marks <html data-story="plain">) the opening is a designed static story: the hero over its
 *     still, then each step beside its own frame of the scene (StoryFrame);
 *   - where the 3D is refused later (software GL, a slow device) the layout stays and the pinned still
 *     turns into the frame of the step being read (the flipbook in the script below).
 * The app's pictures are labelled placeholders until SITE-04 (components/AppShot.astro), shown as tilted
 * panels; three sections carry a small live prop beside their text.
 */
import { SITE_URL } from "../../site.config";
import { plainStoryScript } from "../three/gate";
import { STEP_FRAME, STILL_FRAMES, stepMid, type StepId } from "../three/phases";
import type { SceneName } from "../three/scenes";
import { shotImages } from "../lib/app-shots";
import AppShot from "../components/AppShot.astro";
import Button from "../components/Button.astro";
import HomeAction from "../components/HomeAction.astro";
import Scene from "../components/Scene.astro";
import StoryFrame from "../components/StoryFrame.astro";
import Unshipped from "../components/Unshipped.astro";
import SoundButton from "../components/SoundButton.astro";
import { FEATURES, HERO, OPENING_STEPS, TRUST } from "../data/home";
import { GITHUB_URL, SITE_NAME } from "../data/site";
import Page from "../layouts/Page.astro";
import { loadReleases } from "../lib/releases";
import { canonicalFor, hrefFor } from "../lib/url";

const hasRelease = loadReleases().release !== null;
const screenshot = shotImages("window")[0]?.image;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: SITE_NAME,
    description: HERO.description,
    applicationCategory: "MultimediaApplication",
    operatingSystem: "Windows, macOS, Linux",
    url: canonicalFor(""),
    downloadUrl: canonicalFor("download/"),
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    // a screenshot is named only once SITE-04 has captured a real one
    ...(screenshot ? { screenshot: new URL(screenshot.src, SITE_URL).href } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: SITE_NAME,
    url: SITE_URL,
    logo: new URL("apple-touch-icon.png", SITE_URL).href,
    sameAs: [GITHUB_URL],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE_NAME,
    url: SITE_URL,
  },
];

/**
 * Where 3D is not going to run for a reason known at once, the opening is the static story. The script is
 * built from src/three/gate.ts's own constants (and tested against its blockers), and runs before first
 * paint so nothing moves when the page loads.
 */
const PLAIN_SCRIPT = plainStoryScript();

/** What each step's picture shows, where the opening is a static story. */
const FRAME_ALT: Record<StepId, string> = {
  messy: "A crate of records in blank sleeves of mismatched colors, and behind it an empty Camelot wheel.",
  matched: "The records hanging in a grid, each tagged with its key, like 8A or 11B.",
  ready: "The Camelot wheel lit up, every record in its key's place, each cell showing its key.",
};

/** The sections with a small live scene beside their text: the ones where a moving object says something. */
const PROPS: Partial<Record<string, { scene: SceneName; alt: string }>> = {
  clean: { scene: "record", alt: "A pixel turntable with a record on it." },
  keys: { scene: "wheel", alt: "A pixel Camelot wheel with a column on each key, taller where there are more tracks." },
  waveforms: { scene: "terrain", alt: "A track's waveform drawn as a landscape of pixel columns, with a playhead across it." },
};

/** The closing's turntable: the 24 cells of a Camelot wheel as a pixel picture, drawn here once. */
const cellPath = (ring: 0 | 1, n: number): string => {
  const [r0, r1] = ring === 1 ? [22, 31] : [12, 20.5];
  const a0 = ((n * 30 - 15 + 2) * Math.PI) / 180;
  const a1 = ((n * 30 + 15 - 2) * Math.PI) / 180;
  const pt = (r: number, a: number) => `${(32 + r * Math.sin(a)).toFixed(1)},${(32 - r * Math.cos(a)).toFixed(1)}`;
  return `M${pt(r0, a0)}L${pt(r1, a0)}L${pt(r1, (a0 + a1) / 2)}L${pt(r1, a1)}L${pt(r0, a1)}L${pt(r0, (a0 + a1) / 2)}Z`;
};
const WHEEL_CELLS = Array.from({ length: 24 }, (_, i) => ({ d: cellPath((i % 2) as 0 | 1, Math.floor(i / 2)), tone: (Math.floor(i / 2) + (i % 2) * 3) % 3 }));
---

<Page title={HERO.title} description={HERO.description} path="" schema={schema}>
  <script is:inline set:html={PLAIN_SCRIPT} />

  <section class="opening" id="opening" aria-labelledby="home-heading">
    <div class="stage" data-stage>
      <Scene
        name="opening"
        fill
        priority
        autostart
        frames={Object.keys(STILL_FRAMES)}
        scrub={0.6}
        trigger="#story-track"
        range="top 50%,bottom 50%"
        alt={FRAME_ALT.messy}
      />
      <div class="scrim" aria-hidden="true"></div>
      <div class="handoff" data-handoff aria-hidden="true">
        <div class="handoff-window"><AppShot id="window" bare /></div>
      </div>
      <div class="sound"><SoundButton /></div>
    </div>

    <div class="hero">
      <div class="hero-inner">
        <h1 id="home-heading" data-headline>{HERO.heading}</h1>
        <p class="lead">{HERO.lead}</p>
        <div class="actions">
          <HomeAction />
          <Button href="#story" variant="secondary">See how it works</Button>
        </div>
      </div>
    </div>

    <div class="steps" id="story-track">
      <h2 class="sr-only">How it works</h2>
      <ol>
        {
          OPENING_STEPS.map((step, i) => (
            <li class="step" id={i === 0 ? "story" : undefined} data-step={step.id} style={`--mid: ${stepMid(step.id as StepId)}`}>
              <StoryFrame class="step-frame" scene="opening" frame={STEP_FRAME[step.id as StepId]} alt={FRAME_ALT[step.id as StepId]} />
              <div class="step-copy">
                <span class="num" aria-hidden="true">{i + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="window" id="window" aria-labelledby="window-heading">
    <div class="inner">
      <h2 id="window-heading">And then it is your library, in CuePoint</h2>
      <p class="window-text" data-unshipped="PAGES-10">
        The Camelot wheel is part of the app too. Open it from the header on any page, and click a key to
        see only the tracks in it.
      </p>
      <div class="slab" data-slab="rise"><AppShot id="window" /></div>
    </div>
  </section>

  {
    FEATURES.map((f, i) => {
      const prop = PROPS[f.id];
      return (
        <section class="feature" id={`feature-${f.id}`} aria-labelledby={`feature-${f.id}-heading`} data-side={i % 2 === 0 ? "left" : "right"}>
          <div class="inner">
            <div class="copy">
              <h2 id={`feature-${f.id}-heading`}>{f.heading}</h2>
              <p>{f.text}</p>
              {f.unshipped && <Unshipped step={f.unshipped.step} compact />}
              <p class="more">
                {f.learnMore && (
                  <a href={hrefFor(f.learnMore.path)}>
                    {f.learnMore.label}
                    <span class="sr-only"> about {f.name}</span>
                  </a>
                )}
              </p>
              {prop && (
                <div class="prop">
                  <Scene name={prop.scene} bare autostart alt={prop.alt} />
                </div>
              )}
            </div>
            <div class="slab" data-slab={i % 2 === 0 ? "left" : "right"}>
              <AppShot id={f.shot} />
            </div>
          </div>
        </section>
      );
    })
  }

  <section class="trust" id="trust" aria-labelledby="trust-heading">
    <div class="inner">
      <h2 id="trust-heading">What you can count on</h2>
      <dl class="sheet">
        {
          TRUST.map((t) => (
            <div class="row">
              <dt>{t.title}</dt>
              <dd>
                <p>{t.text}</p>
                {t.id === "open" && (
                  <p>
                    <a href={GITHUB_URL} rel="noopener noreferrer">
                      See the code on GitHub
                    </a>
                  </p>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="get" id="get" aria-labelledby="get-heading">
    <div class="platter" aria-hidden="true">
      <svg class="disc" viewBox="0 0 64 64" width="64" height="64" shape-rendering="crispEdges" focusable="false">
        <rect x="27" y="27" width="10" height="10" class="hub" />
        {WHEEL_CELLS.map((c) => <path d={c.d} class={`cell tone-${c.tone}`} />)}
      </svg>
    </div>
    <div class="inner">
      <h2 id="get-heading">Get CuePoint</h2>
      <p class="get-text">
        {
          hasRelease
            ? "CuePoint is free for Windows, Mac and Linux."
            : "CuePoint 1.0 is not out yet. Get notified on GitHub when it is, and it will be free for Windows, Mac and Linux."
        }
      </p>
      <p class="closing"><HomeAction repeat /></p>
    </div>
  </section>
</Page>

<script>
  // The opening, as the visitor scrolls (only reads layout once a frame, and writes three custom properties):
  //  - the hero's scrim fades as the story begins;
  //  - from the last phase the pinned scene hands over to the app window (only while the 3D runs: otherwise
  //    the slot below the scene is the window, and nothing here changes);
  //  - where the 3D does not run, the pinned still shows the frame of the step being read.
  import { HANDOFF_FROM, frameAt } from "../three/phases";

  const root = document.documentElement;
  const stage = document.querySelector<HTMLElement>("[data-stage]");
  const track = document.getElementById("story-track");
  const scene = stage?.querySelector<HTMLElement>("[data-scene]");
  if (stage && track && scene) {
    let queued = false;
    const update = () => {
      queued = false;
      const r = track.getBoundingClientRect();
      const p = (innerHeight / 2 - r.top) / r.height; // the scene's own progress: the track's top to its bottom at the screen's middle
      const running = scene.dataset["sceneState"] === "running";
      const handoff = running ? Math.min(1, Math.max(0, (p - HANDOFF_FROM) / (1 - HANDOFF_FROM))) : 0;
      stage.style.setProperty("--handoff", String(handoff));
      stage.style.setProperty("--hero", String(Math.min(1, Math.max(0, 1 - scrollY / (innerHeight * 0.9)))));
      if (root.dataset["story"] !== "plain") scene.dataset["frame"] = frameAt(p);
    };
    const schedule = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    addEventListener("scroll", schedule, { passive: true });
    addEventListener("resize", schedule, { passive: true });
    new MutationObserver(schedule).observe(scene, { attributes: true, attributeFilter: ["data-scene-state"] });
    schedule();
  }

  // "See how it works" glides down to the first step, so the camera's dive plays on the way; with reduced
  // motion (or no script) the link jumps there as any link does
  const how = document.querySelector<HTMLAnchorElement>('main a[href="#story"]');
  const first = document.getElementById("story");
  how?.addEventListener("click", (event) => {
    if (!first || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    event.preventDefault();
    first.scrollIntoView({ behavior: "smooth", block: "center" });
    history.pushState(null, "", "#story");
  });
</script>

<script>
  // The headline's build (SITE-06): when the live scene fades in (or, where it never will, once the page
  // is idle), a light runs through the headline letter by letter, each pressed flat and lit in a key's
  // color, then back to its full depth: the wheel lighting key by key, in type. The text is on screen from
  // the first paint (it is the page's largest paint) and never moves: only color and the shadow change,
  // which lay nothing out. Nothing runs with reduced motion.
  import { buildHeadline, startWhenAlive } from "../lib/headline";

  const h1 = document.querySelector<HTMLElement>("[data-headline]");
  const scene = document.querySelector<HTMLElement>("[data-scene='opening']");
  if (h1 && scene) startWhenAlive(scene, () => buildHeadline(h1));
</script>

<style>
  /* the hero letters' extruded depth: a hard outline and two steps of the theme's pressed accent */
  :global(html) {
    --headline-depth: 2px 2px 0 var(--accent-primary-pressed), 4px 4px 0 var(--accent-primary-pressed), 6px 6px 0 var(--border-outline);
  }
  .inner {
    width: min(100% - 2 * var(--gutter), var(--content-max));
    margin-inline: auto;
  }

  /* ---- the opening: a tall section, a full-screen pinned stage, the hero and the steps over it ---- */
  .opening {
    position: relative;
    height: 560svh;
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    background: var(--bg-app);
  }
  /* the hero's scrim: hard steps of the page's own color, so the headline reads over any frame */
  .scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: var(--hero, 1);
    background: linear-gradient(
      180deg,
      var(--bg-app) 0 34%,
      color-mix(in srgb, var(--bg-app) 72%, transparent) 34% 42%,
      color-mix(in srgb, var(--bg-app) 44%, transparent) 42% 49%,
      color-mix(in srgb, var(--bg-app) 18%, transparent) 49% 55%,
      transparent 55%
    );
  }
  .sound {
    position: absolute;
    right: var(--gutter);
    bottom: var(--space-xl);
    z-index: 3;
  }

  .hero {
    position: absolute;
    inset: 0 0 auto 0;
    height: 100svh;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    pointer-events: none;
  }
  .hero-inner {
    width: min(100% - 2 * var(--gutter), var(--content-max));
    margin-inline: auto;
    padding-top: var(--space-xl);
    pointer-events: auto;
  }
  .hero h1 {
    max-width: 15ch;
    margin: 0 0 var(--space-lg);
    font-size: clamp(2.25rem, 0.9rem + 4.4vw, 4.75rem);
    line-height: 1.04;
    letter-spacing: 0.01em;
    text-shadow: var(--headline-depth);
  }
  .lead {
    max-width: 34rem;
    margin: 0 0 var(--space-xl);
    font-size: var(--font-size-md);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  /* the steps: a track as long as the story's scroll; each step sits at the middle of its span */
  .steps {
    position: absolute;
    top: 50svh;
    bottom: 50svh;
    left: 0;
    right: 0;
    z-index: 2;
    pointer-events: none;
  }
  .steps ol {
    position: relative;
    height: 100%;
    width: min(100% - 2 * var(--gutter), var(--content-max));
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .step {
    position: absolute;
    left: 0;
    top: calc(var(--mid) * 100%);
    transform: translateY(-50%);
    width: min(100%, 34rem);
    pointer-events: auto;
    /* "See how it works" lands with the first step in the middle of the screen */
    scroll-margin-top: 28svh;
  }
  .step :global(.step-frame) {
    display: none;
  }
  .step h3 {
    margin: var(--space-md) 0 var(--space-lg);
    font-size: clamp(2rem, 1rem + 3.4vw, 3.75rem);
    line-height: 1.02;
    /* a hard pixel outline, so the big type reads over any frame of the scene */
    text-shadow:
      -3px 0 0 var(--border-outline),
      3px 0 0 var(--border-outline),
      0 -3px 0 var(--border-outline),
      0 3px 0 var(--border-outline),
      3px 3px 0 var(--border-outline),
      -3px -3px 0 var(--border-outline),
      3px -3px 0 var(--border-outline),
      -3px 3px 0 var(--border-outline),
      6px 6px 0 var(--accent-primary-pressed);
  }
  .step p {
    margin: 0;
    padding: var(--space-lg) var(--space-xl);
    background: var(--bg-panel);
    border: var(--border-width) solid var(--border-outline);
    box-shadow: var(--shadow-bevel-panel), var(--shadow-panel);
    font-size: var(--font-size-md);
  }
  .num {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--accent-primary);
    color: var(--border-outline);
    border: var(--border-width) solid var(--border-outline);
    box-shadow: var(--shadow-bevel), var(--shadow-badge);
    font-family: var(--font-pixel);
    font-weight: 700;
    font-size: var(--font-size-lg);
  }

  /* the handoff: the app window's slot rises flat out of the wheel (DEC-189) */
  .handoff {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    opacity: min(1, calc(var(--handoff, 0) * 2.5));
    perspective: 1400px;
    pointer-events: none;
  }
  .handoff-window {
    width: min(92vw, 62rem, (100svh - 6rem) * 1.6);
    transform: translateY(calc((1 - var(--handoff, 0)) * 22svh)) rotateX(calc((1 - var(--handoff, 0)) * 64deg)) scale(calc(0.82 + 0.18 * var(--handoff, 0)));
    transform-origin: 50% 100%;
  }
  .handoff :global(.frame) {
    box-shadow: var(--shadow-modal);
  }

  @media (min-width: 40rem) {
    .lead {
      font-size: var(--font-size-lg);
      line-height: 1.5;
    }
  }
  @media (min-width: 60rem) {
    .hero {
      align-items: center;
    }
    .hero-inner {
      padding: 0 0 6svh;
    }
    .scrim {
      background: linear-gradient(
        90deg,
        var(--bg-app) 0 26%,
        color-mix(in srgb, var(--bg-app) 72%, transparent) 26% 33%,
        color-mix(in srgb, var(--bg-app) 44%, transparent) 33% 39%,
        color-mix(in srgb, var(--bg-app) 18%, transparent) 39% 44%,
        transparent 44%
      );
    }
  }

  /* ---- the static story: where no 3D will run for a reason known at once, or with reduced motion ---- */
  :global(:root[data-story="plain"]) .opening {
    height: auto;
  }
  :global(:root[data-story="plain"]) .stage {
    position: absolute;
    inset: 0 0 auto 0;
  }
  :global(:root[data-story="plain"]) .hero {
    position: relative;
    min-height: 100svh;
  }
  :global(:root[data-story="plain"]) .steps {
    position: static;
  }
  :global(:root[data-story="plain"]) .steps ol {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-xl);
  }
  :global(:root[data-story="plain"]) .step {
    position: static;
    transform: none;
    width: auto;
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }
  :global(:root[data-story="plain"]) .step :global(.step-frame) {
    display: block;
  }
  :global(:root[data-story="plain"]) .handoff {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .opening {
      height: auto;
    }
    .stage {
      position: absolute;
      inset: 0 0 auto 0;
    }
    .hero {
      position: relative;
      min-height: 100svh;
    }
    .steps {
      position: static;
    }
    .steps ol {
      display: grid;
      gap: var(--space-xl);
      padding-block: var(--space-xl);
    }
    .step {
      position: static;
      transform: none;
      width: auto;
      display: grid;
      gap: var(--space-lg);
      align-items: center;
    }
    .step :global(.step-frame) {
      display: block;
    }
    .handoff {
      display: none;
    }
  }
  @media (min-width: 60rem) {
    :global(:root[data-story="plain"]) .step {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-xl) calc(var(--space-xl) * 2);
    }
  }
  @media (min-width: 60rem) and (prefers-reduced-motion: reduce) {
    .step {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-xl) calc(var(--space-xl) * 2);
    }
  }

  /* ---- the app's pictures as panels with depth: tilted slabs, extruded in hard pixel steps ---- */
  .slab {
    --ry: -10deg;
    --rx: 5deg;
    perspective: 1600px;
  }
  .slab[data-slab="right"] {
    --ry: 10deg;
  }
  .slab[data-slab="rise"] {
    --ry: 0deg;
    --rx: 8deg;
  }
  .slab :global(.frame) {
    transform: rotateY(var(--ry)) rotateX(var(--rx));
    transform-origin: 50% 50%;
    box-shadow:
      1px 1px 0 var(--bg-panel-alt),
      2px 2px 0 var(--bg-panel-alt),
      3px 3px 0 var(--bg-panel-alt),
      4px 4px 0 var(--bg-panel-alt),
      5px 5px 0 var(--border-highlight),
      6px 6px 0 var(--border-highlight),
      7px 7px 0 var(--border-highlight),
      8px 8px 0 var(--border-highlight),
      10px 10px 0 var(--border-outline),
      22px 26px 0 color-mix(in srgb, var(--border-shadow) 70%, transparent);
  }
  .slab[data-slab="right"] :global(.frame) {
    box-shadow:
      -1px 1px 0 var(--bg-panel-alt),
      -2px 2px 0 var(--bg-panel-alt),
      -3px 3px 0 var(--bg-panel-alt),
      -4px 4px 0 var(--bg-panel-alt),
      -5px 5px 0 var(--border-highlight),
      -6px 6px 0 var(--border-highlight),
      -7px 7px 0 var(--border-highlight),
      -8px 8px 0 var(--border-highlight),
      -10px 10px 0 var(--border-outline),
      -22px 26px 0 color-mix(in srgb, var(--border-shadow) 70%, transparent);
  }
  .slab :global(figcaption) {
    margin-top: var(--space-xl);
  }
  /* as a panel comes into view it swings round to face the visitor: its own scroll, CSS only, no script */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .slab :global(.frame) {
        animation: slab-swing linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 50%;
      }
      .slab[data-slab="rise"] :global(.frame) {
        animation-name: slab-rise;
      }
      .prop {
        animation: prop-drift linear both;
        animation-timeline: view();
      }
    }
  }
