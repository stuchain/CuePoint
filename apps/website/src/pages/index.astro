---
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import { PRIMARY_ACTION } from "../data/site";
import Page from "../layouts/Page.astro";
---

<Page
  title="CuePoint: clean up your Rekordbox library"
  description="CuePoint is a free desktop app for DJs that cleans up a Rekordbox library."
  path=""
>
  <Section id="intro" width="prose">
    <h1>CuePoint</h1>
    <p>CuePoint is a free desktop app for DJs. It cleans up a Rekordbox library.</p>
    <Button href={PRIMARY_ACTION.href} external>{PRIMARY_ACTION.label}</Button>
  </Section>
</Page>
