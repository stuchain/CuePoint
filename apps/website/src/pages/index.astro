---
/*
 * The home page (SITE-06): what CuePoint does for a DJ, in one screen; then the opening that shows it
 * (DEC-189: the crate becomes the wheel); then one section for each thing the app does, the reasons to
 * trust it, and the download.
 *
 * The opening is one full-screen scene, pinned (CSS sticky) for the whole of a tall section. Its first
 * screen is the hero: the headline, one primary action and a quiet "See how it works" over the scene,
 * which moves on its own as soon as the page is idle (Scene's `autostart`), fading in over its still.
 * Scrolling drives the camera through the story, and a track of three steps scrolls over it, each a
 * solid plate (the app's own panel) with a big title, so the type never sits on the records. The scene's
 * scroll range is that track (`trigger`, from its top at the middle of the screen to its bottom at the
 * middle), so each step, placed at the middle of its span of src/three/phases.ts, is on its reading line
 * (READING_LINE: the middle of a wide screen, low on an upright one) exactly while the scene shows what it
 * says, and the scene leans away from it (opening.ts, storyLean). Three marks at the foot of the screen
 * say which step is being told. The steps say the whole story in words, so nothing is only in the 3D. In
 * the last phase the pinned scene hands over to the app window's slot, which rises flat out of the wheel
 * (DEC-189), filling an upright phone's screen.
 *
 * Where the 3D does not run:
 *   - with reduced motion, saveData, a small device or no WebGL 2 (known before first paint: the inline
 *     script marks <html data-story="plain">) the opening is a designed static story: the hero over its
 *     still, then each step beside its own frame of the scene (StoryFrame);
 *   - where the 3D is refused later (software GL, a slow device) the layout stays and the pinned still
 *     turns into the frame of the step being read (the flipbook in the script below).
 * The app's pictures are labelled placeholders until SITE-04 (components/AppShot.astro); the home page has
 * one, the app's window.
 *
 * Below the story the page is one system (the owner's direction, 2026-10-09: draw people in, keep the
 * details on the feature pages): every section is the same grid, its heading in the left column and its
 * content in the right, with a seam (the app's groove: an outline over a highlight) between them.
 *   - what CuePoint does: the window, then five teasers of one line each, each linking its feature page;
 *   - what you can count on: five one-line claims, in one of the app's panels;
 *   - the closing band, the one block in the accent.
 */
import { SITE_URL } from "../../site.config";
import { plainStoryScript } from "../three/gate";
import { STEP_FRAME, STILL_FRAMES, stepMid, type StepId } from "../three/phases";
import { shotImages } from "../lib/app-shots";
import AppShot from "../components/AppShot.astro";
import HomeAction from "../components/HomeAction.astro";
import Scene from "../components/Scene.astro";
import StoryFrame from "../components/StoryFrame.astro";
import SoundButton from "../components/SoundButton.astro";
import { FEATURES, HERO, OPENING_STEPS, TRUST } from "../data/home";
import { GITHUB_URL, SITE_NAME } from "../data/site";
import Page from "../layouts/Page.astro";
import { loadReleases } from "../lib/releases";
import { canonicalFor, hrefFor } from "../lib/url";

const hasRelease = loadReleases().release !== null;
const screenshot = shotImages("window")[0]?.image;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: SITE_NAME,
    description: HERO.description,
    applicationCategory: "MultimediaApplication",
    operatingSystem: "Windows, macOS, Linux",
    url: canonicalFor(""),
    downloadUrl: canonicalFor("download/"),
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    // a screenshot is named only once SITE-04 has captured a real one
    ...(screenshot ? { screenshot: new URL(screenshot.src, SITE_URL).href } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: SITE_NAME,
    url: SITE_URL,
    logo: new URL("apple-touch-icon.png", SITE_URL).href,
    sameAs: [GITHUB_URL],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE_NAME,
    url: SITE_URL,
  },
];

/**
 * Where 3D is not going to run for a reason known at once, the opening is the static story. The script is
 * built from src/three/gate.ts's own constants (and tested against its blockers), and runs before first
 * paint so nothing moves when the page loads.
 */
const PLAIN_SCRIPT = plainStoryScript();

/** What each step's picture shows, where the opening is a static story. */
const FRAME_ALT: Record<StepId, string> = {
  messy: "A crate of records in blank gray sleeves, and behind it an empty Camelot wheel.",
  matched: "The records hanging in a grid, each tagged with its key, like 8A or 11B.",
  ready: "The Camelot wheel lit up, every record in its key's place, each cell showing its key.",
};

/** The closing's turntable: the 24 cells of a Camelot wheel as a pixel picture, drawn here once. */
const cellPath = (ring: 0 | 1, n: number): string => {
  const [r0, r1] = ring === 1 ? [22, 31] : [12, 20.5];
  const a0 = ((n * 30 - 15 + 2) * Math.PI) / 180;
  const a1 = ((n * 30 + 15 - 2) * Math.PI) / 180;
  const pt = (r: number, a: number) => `${(32 + r * Math.sin(a)).toFixed(1)},${(32 - r * Math.cos(a)).toFixed(1)}`;
  return `M${pt(r0, a0)}L${pt(r1, a0)}L${pt(r1, (a0 + a1) / 2)}L${pt(r1, a1)}L${pt(r0, a1)}L${pt(r0, (a0 + a1) / 2)}Z`;
};
const WHEEL_CELLS = Array.from({ length: 24 }, (_, i) => ({ d: cellPath((i % 2) as 0 | 1, Math.floor(i / 2)), tone: (Math.floor(i / 2) + (i % 2) * 3) % 3 }));
---


<Page title={HERO.title} description={HERO.description} path="" schema={schema}>
  <script is:inline set:html={PLAIN_SCRIPT} />

  <section class="opening" id="opening" aria-labelledby="home-heading">
    <div class="stage" data-stage>
      <Scene
        name="opening"
        fill
        priority
        autostart
        frames={Object.keys(STILL_FRAMES)}
        scrub={0.6}
        trigger="#story-track"
        range="top 50%,bottom 50%"
        alt={FRAME_ALT.messy}
      />
      <div class="handoff" data-handoff aria-hidden="true">
        <div class="handoff-window"><AppShot id="window" bare /></div>
      </div>
      <ol class="beats" aria-hidden="true">
        {OPENING_STEPS.map((step) => <li data-beat-mark={step.id} />)}
      </ol>
      <div class="sound"><SoundButton /></div>
    </div>

    <div class="hero">
      <div class="hero-inner">
        <div class="hero-copy" data-hero-copy>
        <h1 id="home-heading" data-headline>{HERO.heading}</h1>
        <p class="lead">{HERO.lead}</p>
        <div class="actions">
          <HomeAction />
          <a class="how" href="#story">
            See how it works
            <svg viewBox="0 0 7 7" width="14" height="14" aria-hidden="true" focusable="false" shape-rendering="crispEdges">
              <rect x="3" y="0" width="1" height="7" /><rect x="1" y="3" width="1" height="1" /><rect x="5" y="3" width="1" height="1" /><rect x="2" y="4" width="1" height="2" /><rect x="4" y="4" width="1" height="2" />
            </svg>
          </a>
        </div>
        </div>
      </div>
    </div>

    <div class="steps" id="story-track">
      <h2 class="sr-only">How it works</h2>
      <ol>
        {
          OPENING_STEPS.map((step, i) => (
            <li class="step" id={i === 0 ? "story" : undefined} data-step={step.id} style={`--mid: ${stepMid(step.id as StepId)}`}>
              <StoryFrame class="step-frame" scene="opening" frame={STEP_FRAME[step.id as StepId]} alt={FRAME_ALT[step.id as StepId]} />
              <div class="plate" data-plate>
                <span class="num" aria-hidden="true">{i + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band what" id="window" aria-labelledby="what-heading">
    <div class="inner grid">
      <h2 id="what-heading">What CuePoint does</h2>
      <div class="content">
        <div class="slab"><AppShot id="window" /></div>
        <ul class="teasers">
          {
            FEATURES.map((f) => (
              <li class="teaser" id={`feature-${f.id}`}>
                <h3 id={`feature-${f.id}-heading`}>{f.name}</h3>
                <p>{f.text}</p>
                <a class="more" href={hrefFor(f.learnMore.path)}>
                  {f.learnMore.label}
                  <span class="sr-only"> about {f.name}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="all"><a class="more" href={hrefFor("features/")}>All of CuePoint's features</a></p>
      </div>
    </div>
  </section>

  <section class="band trust" id="trust" aria-labelledby="trust-heading">
    <div class="inner grid">
      <h2 id="trust-heading">What you can count on</h2>
      <dl class="sheet">
        {
          TRUST.map((t) => (
            <div class="row">
              <dt>{t.title}</dt>
              <dd>
                {t.text}
                {t.id === "open" && (
                  <>
                    {" "}
                    <a class="more" href={GITHUB_URL} rel="noopener noreferrer">
                      See the code on GitHub
                    </a>
                  </>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="get" id="get" aria-labelledby="get-heading">
    <div class="platter" aria-hidden="true">
      <svg class="disc" viewBox="0 0 64 64" width="64" height="64" shape-rendering="crispEdges" focusable="false">
        <rect x="27" y="27" width="10" height="10" class="hub" />
        {WHEEL_CELLS.map((c) => <path d={c.d} class={`cell tone-${c.tone}`} />)}
      </svg>
    </div>
    <div class="inner">
      <h2 id="get-heading">Get CuePoint</h2>
      <p class="get-text">
        {
          hasRelease
            ? "CuePoint is free for Windows, Mac and Linux."
            : "CuePoint 1.0 is not out yet. Get notified on GitHub when it is, and it will be free for Windows, Mac and Linux."
        }
      </p>
      <p class="closing"><HomeAction repeat /></p>
    </div>
  </section>
</Page>

<script>
  // The opening, as the visitor scrolls (only reads layout once a frame, and writes a few custom properties):
  //  - --hero goes from 1 to 0 as the hero scrolls away (the marks wait for it);
  //  - the marks at the foot of the screen say which step is being told;
  //  - from the last phase the pinned scene hands over to the app window (only while the 3D runs: otherwise
  //    the slot below the scene is the window, and nothing here changes);
  //  - where the 3D does not run, the pinned still shows the frame of the step being read.
  // Once the live scene runs, the story's plates print in as they reach their line (lib/story-motion.ts,
  // loaded then and only then, with the 3D's own GSAP).
  import { HANDOFF_FROM, beatAt, frameAt } from "../three/phases";

  const root = document.documentElement;
  const stage = document.querySelector<HTMLElement>("[data-stage]");
  const track = document.getElementById("story-track");
  const scene = stage?.querySelector<HTMLElement>("[data-scene]");
  if (stage && track && scene) {
    let queued = false;
    let motion = false;
    const update = () => {
      queued = false;
      const r = track.getBoundingClientRect();
      const p = (innerHeight / 2 - r.top) / r.height; // the scene's own progress: the track's top to its bottom at the screen's middle
      const running = scene.dataset["sceneState"] === "running";
      const handoff = running ? Math.min(1, Math.max(0, (p - HANDOFF_FROM) / (1 - HANDOFF_FROM))) : 0;
      stage.style.setProperty("--handoff", String(handoff));
      stage.style.setProperty("--hero", String(Math.min(1, Math.max(0, 1 - scrollY / (innerHeight * 0.9)))));
      stage.dataset["beat"] = beatAt(p) ?? "none";
      if (root.dataset["story"] !== "plain") scene.dataset["frame"] = frameAt(p);
      if (running && !motion && root.dataset["story"] !== "plain") {
        motion = true;
        const plates = Array.from(document.querySelectorAll<HTMLElement>("[data-plate]"));
        void import("../lib/story-motion").then((m) => m.startStoryMotion(plates)).catch(() => undefined);
      }
    };
    const schedule = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    addEventListener("scroll", schedule, { passive: true });
    addEventListener("resize", schedule, { passive: true });
    new MutationObserver(schedule).observe(scene, { attributes: true, attributeFilter: ["data-scene-state"] });
    schedule();
  }

  // "See how it works" glides down to the first step, so the camera's dive plays on the way; with reduced
  // motion (or no script) the link jumps there as any link does
  const how = document.querySelector<HTMLAnchorElement>('main a[href="#story"]');
  const first = document.getElementById("story");
  how?.addEventListener("click", (event) => {
    if (!first || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    event.preventDefault();
    first.scrollIntoView({ behavior: "smooth", block: "center" });
    history.pushState(null, "", "#story");
  });
</script>

<script>
  // The headline's build (SITE-06): when the live scene fades in (or, where it never will, once the page
  // is idle), a light runs through the headline letter by letter, each pressed flat and lit in a shade
  // of the accent, then back to its full depth: the wheel lighting key by key, in type. The text is on screen from
  // the first paint (it is the page's largest paint) and never moves: only color and the shadow change,
  // which lay nothing out. Nothing runs with reduced motion.
  import { buildHeadline, startWhenAlive } from "../lib/headline";

  const h1 = document.querySelector<HTMLElement>("[data-headline]");
  const scene = document.querySelector<HTMLElement>("[data-scene='opening']");
  if (h1 && scene) startWhenAlive(scene, () => buildHeadline(h1));
</script>

<style>
  /*
   * One system for the whole page.
   *   Rhythm: --r1 (a gap inside a group) < --r2 (between groups) < --r3 (a block's breathing room) <
   *           --r4 (between sections); more room above a heading than below it.
   *   Type:   --t-display (the h1 and the closing), --t-title (every section's and step's title),
   *           --t-lead (the hero's lead and the section texts' first size), the body size for the rest.
   *   Edges:  everything hangs from the content column's left edge; the app's outline (2px black), its
   *           bevel and its hard shadows are the only depth; a seam (outline over highlight) between sections.
   */
  :global(html) {
    /* the hero letters' extruded depth: a hard outline and two steps of the theme's pressed accent */
    --headline-depth: 2px 2px 0 var(--accent-primary-pressed), 4px 4px 0 var(--accent-primary-pressed), 6px 6px 0 var(--border-outline);
  }
  .opening,
  .band,
  .get {
    --r1: var(--space-xl);
    --r2: calc(var(--space-xl) * 2);
    --r3: calc(var(--space-xl) * 3.2);
    --r4: clamp(4.5rem, 2.5rem + 6vw, 8.5rem);
    --t-display: clamp(2.5rem, 1.2rem + 3.8vw, 4.25rem);
    --t-title: clamp(1.9rem, 1.1rem + 2.4vw, 3.25rem);
    --t-lead: clamp(1.1rem, 1rem + 0.45vw, var(--font-size-lg));
    --column: min(100% - 2 * var(--gutter), var(--content-max));
    --column-left: max(var(--gutter), (100% - var(--content-max)) / 2);
  }
  .inner {
    width: var(--column);
    margin-inline: auto;
  }

  /* ---- the opening: a tall section, a full-screen pinned stage, the hero and the steps over it ---- */
  .opening {
    position: relative;
    height: 520svh;
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    background: var(--bg-app);
  }
  .sound {
    position: absolute;
    right: var(--gutter);
    bottom: var(--r1);
    z-index: 3;
  }

  .hero {
    position: absolute;
    inset: 0 0 auto 0;
    height: 100svh;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    pointer-events: none;
    /* the copy's backing below reaches to the screen's edges, never past the first screen */
    overflow: hidden;
  }
  .hero-inner {
    width: var(--column);
    margin-inline: auto;
    padding-top: var(--r1);
    pointer-events: auto;
  }
  /*
   * The copy's backing: the page's own color, solid under every letter, the button and the link, with a
   * short fade in hard steps on the side that faces the scene. It is part of the copy, so it scrolls away
   * with it, and the scene never sits under the text however it leans or however wide the screen is
   * (e2e/home.spec.ts reads the pixels under the copy). Upright and narrow: solid from the top, the fade below.
   */
  .hero-copy {
    --fade: 3rem;
    position: relative;
    isolation: isolate;
  }
  .hero-copy::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -100svh -100vw calc(-1 * (var(--r1) + var(--fade))) -100vw;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--bg-app) 25%, transparent) 0 1rem,
      color-mix(in srgb, var(--bg-app) 55%, transparent) 1rem 2rem,
      color-mix(in srgb, var(--bg-app) 82%, transparent) 2rem 3rem,
      var(--bg-app) 3rem
    );
    pointer-events: none;
  }
  .hero h1 {
    max-width: 14ch;
    margin: 0 0 var(--r1);
    font-size: var(--t-display);
    line-height: 1.02;
    letter-spacing: 0.01em;
    text-shadow: var(--headline-depth);
  }
  .lead {
    max-width: 29rem;
    margin: 0 0 var(--r2);
    font-size: var(--t-lead);
    line-height: 1.5;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--r1) calc(var(--r1) * 1.6);
  }
  .actions :global([data-primary-action]) {
    font-size: var(--font-size-lg);
    padding: var(--space-md) calc(var(--space-xl) * 1.2);
  }
  /* the secondary: a quiet link with a pixel arrow down, not a second button competing with the first */
  .how {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 44px;
    font-family: var(--font-pixel);
    font-weight: 600;
    color: var(--fg-primary);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }
  .how svg {
    fill: currentColor;
  }
  .how:hover {
    color: var(--accent-primary-hover);
  }
  @media (prefers-reduced-motion: no-preference) {
    .how svg {
      /* a few nudges once the page has settled, then it rests: a cue, not a loop */
      animation: nudge 0.9s steps(2, jump-none) 2.4s 4;
    }
  }
  @keyframes nudge {
    50% {
      translate: 0 3px;
    }
  }

  /* the steps: a track as long as the story's scroll; each step sits on its reading line at the middle of its span */
  .steps {
    --reading-offset: 0svh;
    position: absolute;
    top: 50svh;
    bottom: 50svh;
    left: 0;
    right: 0;
    z-index: 2;
    pointer-events: none;
  }
  .steps ol {
    position: relative;
    height: 100%;
    width: var(--column);
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .step {
    position: absolute;
    left: 0;
    top: calc(var(--mid) * 100% + var(--reading-offset));
    transform: translateY(-50%);
    width: min(100%, 31rem);
    pointer-events: auto;
    /* "See how it works" lands with the first step whole on the screen */
    scroll-margin-top: 28svh;
  }
  .step :global(.step-frame) {
    display: none;
  }
  /* a step is one of the app's panels: an outline, a bevel and a hard shadow, so the big title never sits on the records */
  .plate {
    position: relative;
    padding: calc(var(--r1) * 1.6) var(--r2) var(--r2);
    background: var(--bg-panel);
    border: var(--border-width-heavy) solid var(--border-outline);
    box-shadow: var(--shadow-bevel-panel), var(--shadow-modal);
  }
  .plate h3 {
    margin: 0 0 var(--r1);
    font-size: var(--t-title);
    line-height: 1.02;
  }
  .plate p {
    max-width: 30rem;
    margin: 0;
    font-size: var(--t-lead);
    line-height: 1.5;
  }
  /* the number hangs off the plate's corner: a key of the wheel, in the accent */
  .num {
    position: absolute;
    top: calc(-1 * var(--r1) * 1.3);
    left: calc(-1 * var(--r1));
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    background: var(--accent-primary);
    color: var(--border-outline);
    border: var(--border-width-heavy) solid var(--border-outline);
    box-shadow: var(--shadow-bevel), var(--shadow-badge);
    font-family: var(--font-pixel);
    font-weight: 700;
    /* Pixelify's figures stand at its x-height: a size up keeps the number the tile's one thing */
    font-size: 2.5rem;
    line-height: 1;
  }

  /* which step is being told: three marks on the content column's edge, at the foot of the screen */
  .beats {
    position: absolute;
    left: var(--column-left);
    bottom: var(--r1);
    z-index: 3;
    display: flex;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
    opacity: calc((1 - var(--hero, 1)) * (1 - min(1, var(--handoff, 0) * 4)));
    pointer-events: none;
  }
  .beats li {
    width: 1.5rem;
    height: 0.625rem;
    background: var(--bg-panel);
    border: var(--border-width) solid var(--border-outline);
    box-shadow: var(--shadow-badge);
    transition:
      width var(--motion-base) steps(2),
      background-color var(--motion-base) steps(2);
  }
  .stage[data-beat="messy"] [data-beat-mark="messy"],
  .stage[data-beat="matched"] [data-beat-mark="matched"],
  .stage[data-beat="ready"] [data-beat-mark="ready"] {
    width: 3rem;
    background: var(--accent-primary);
  }

  /* the handoff: the app window's slot rises flat out of the wheel (DEC-189) */
  .handoff {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    opacity: min(1, calc(var(--handoff, 0) * 2.5));
    perspective: 1400px;
    pointer-events: none;
  }
  .handoff-window {
    width: min(92vw, 62rem, (100svh - 6rem) * 1.6);
    transform: translateY(calc((1 - var(--handoff, 0)) * 22svh)) rotateX(calc((1 - var(--handoff, 0)) * 64deg)) scale(calc(0.82 + 0.18 * var(--handoff, 0)));
    transform-origin: 50% 100%;
  }
  .handoff :global(.frame) {
    box-shadow: var(--shadow-modal);
  }

  /* an upright screen: the steps read low, under the picture (which leans up, scenes/opening.ts), and the
     window that rises at the end fills the screen's height instead of floating small in it */
  @media (max-aspect-ratio: 4/5) {
    .steps {
      --reading-offset: 24svh;
    }
    .handoff-window {
      --window-width: min(150vw, (100svh - 8rem) * 1.6);
      width: var(--window-width);
      /* wider than the screen: centered on it, both sides cut alike */
      justify-self: start;
      margin-left: calc((100vw - var(--window-width)) / 2);
    }
  }
