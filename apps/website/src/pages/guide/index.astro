---
/** /guide/: the guide's front page. The search box first, then every page, in order, by section. */
import GuideSearch from "../../components/GuideSearch.astro";
import PageHead from "../../components/PageHead.astro";
import Section from "../../components/Section.astro";
import { guidePath, guideSections, guideSlug } from "../../content/guide";
import Page from "../../layouts/Page.astro";
import { hrefFor } from "../../lib/url";

const sections = guideSections();
---

<Page
  title="CuePoint user guide"
  description="How to use CuePoint with your Rekordbox collection: import, match on Beatport, clean up, plan a set and export, explained for DJs."
  path="guide/"
  breadcrumbs={[
    { label: "Home", path: "" },
    { label: "Guide", path: "guide/" },
  ]}
>
  <PageHead title="CuePoint user guide">
    <p>
      Everything CuePoint does with your Rekordbox collection, in the order you will meet it. New here? Start with{" "}
      <a href={hrefFor("guide/getting-started/")}>Getting started</a>.
    </p>
  </PageHead>

  <div class="search-wrap">
    <GuideSearch />
  </div>

  {
    sections.map((section) => (
      <Section id={`sec-${section.id}`} heading={section.label} layout="split">
        <ul class="rows">
          {section.pages.map((p) => (
            <li data-reveal>
              <a class="row-name" href={hrefFor(guidePath(guideSlug(p.file)))}>
                {p.title}
              </a>
              <p>{p.description}</p>
            </li>
          ))}
        </ul>
      </Section>
    ))
  }
</Page>

<style>
  .search-wrap {
    width: min(100% - 2 * var(--gutter), var(--content-max));
    margin: 0 auto var(--r2);
  }
</style>
