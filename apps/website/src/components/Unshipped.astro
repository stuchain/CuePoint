---
/**
 * A note on a page or section that describes a feature the app does not ship yet (SITE-08). It is for
 * the preview only: its wrapper carries `data-unshipped`, and scripts/check-site.mjs fails a public build
 * while any remains. Remove it, and the marker in the data, in the step that ships the feature.
 */
interface Props {
  /** The step that ships the feature, for example "PAGES-16". */
  step: string;
  /** A short note beside a card or a heading, instead of the full callout. */
  compact?: boolean;
}
import { fmt } from "../i18n/format";
import { localeFromUrl } from "../i18n/paths";
import { ui } from "../i18n/ui";

const { step, compact = false } = Astro.props;
const t = ui(localeFromUrl(Astro.url)).unshipped;
---

{
  compact ? (
    <p class="compact" data-unshipped={step}>
      {fmt(t.compact, { step })}
    </p>
  ) : (
    <aside class="note" data-unshipped={step}>
      <p>
        <strong>{t.title}</strong> {fmt(t.body, { step })}
      </p>
    </aside>
  )
}

<style>
  .note {
    margin-block: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    background: var(--bg-panel);
    color: var(--fg-primary);
    border: var(--border-width) solid var(--border-outline);
    border-left: calc(var(--border-width) * 3) solid var(--accent-warning);
    box-shadow: var(--shadow-bevel-panel);
  }
  .note p,
  .compact {
    margin: 0;
  }
  .compact {
    font-size: var(--font-size-sm);
    color: var(--fg-primary);
  }
</style>
