---
import { NAV } from "../data/nav";
import { PRIMARY_ACTION, SITE_NAME } from "../data/site";
import { LOCALES, localeInfo, type LocaleCode } from "../i18n/locales";
import { leavesLanguage, localeFromUrl, localePath, switchTargets } from "../i18n/paths";
import { navLabel, ui } from "../i18n/ui";
import { loadReleases } from "../lib/releases";
import { hrefFor } from "../lib/url";
import mark from "../assets/mark/mark-32.svg";
import Button from "./Button.astro";
import DownloadLabel from "./DownloadLabel.astro";

interface Props {
  /** The current page's path, relative to the base, to mark its link. It is the English path, whatever language the page is in. */
  currentPath?: string;
  /** The page's language; read from the address when left out. */
  locale?: LocaleCode;
}
const { currentPath } = Astro.props;
const locale = Astro.props.locale ?? localeFromUrl(Astro.url);
const t = ui(locale);
const info = localeInfo(locale);
// the language switch: the same page in each language, or that language's home page when the page is English only
const targets = switchTargets(currentPath ?? "").map((target) => ({ ...target, info: localeInfo(target.code) }));
// a link to a page with no translation says it leaves the language (DEC-311)
const toHreflang = (path: string) => (leavesLanguage(locale, path) ? localeInfo("en").hreflang : undefined);
// The language switch (DEC-311): on a phone it is the last row of the menu (below 62.5rem), from there on a button
// after the seam. The button is a <details>, so it opens on a click with no script; lib/lang-switch.ts closes it
// on an outside click or Escape.
// a pixel globe, 8 by 7
const GLOBE = ["..XXXX..", ".X.XX.X.", "X..XX..X", "XXXXXXXX", "X..XX..X", ".X.XX.X.", "..XXXX.."];
const globe = GLOBE.flatMap((row, y) => [...row.matchAll(/X+/g)].map((m) => `M${m.index} ${y}h${m[0].length}v1h-${m[0].length}z`)).join("");

/** "page" for the page itself, "true" for any page inside its section (/guide/ for /guide/library/). */
function current(path: string): "page" | "true" | undefined {
  if (currentPath === undefined) return undefined;
  if (path === currentPath) return "page";
  return path !== "" && currentPath.startsWith(path) ? "true" : undefined;
}
// Before 1.0.0 the primary action is "Get notified of 1.0". Once the release data holds a normal
// release it becomes a Download button that names the visitor's system (SITE-07).
const releases = loadReleases();
const hasRelease = releases.release !== null;
// only what the script needs: the files, without the checksums
const scriptData = JSON.stringify({ files: releases.files.map(({ system, chip, url }) => ({ system, chip, url })) }).replace(/</g, "\\u003c");
---

<!-- Sticky on every page but the home page, whose story holds the whole screen. It is its own layer in the
     page-to-page transition (view-transition-name in the styles), so it stays still while the page fades. -->
<header class="header" data-sticky={currentPath === "" ? undefined : "true"}>
  <div class="chrome">
  <div class="bar" data-home={currentPath === "" ? "true" : undefined}>
    <a class="brand" href={hrefFor(localePath(locale, ""))}>
      <img class="mark" src={mark.src} width="32" height="32" alt="" />
      <span class="name">{SITE_NAME}</span>
    </a>

    <!-- The site wears one theme, the app's default Neo Dark (the owner's choice, 2026-10-09): there is no theme switch. On a phone the nav sits in a menu (a <details>: it works without JavaScript). From 62.5rem up they are in the bar as before. -->
    <details class="menu">
      <summary class="menu-toggle">{t.menu}</summary>
      <div class="menu-body">
        <nav class="nav" aria-label={t.mainNav}>
          <ul>
            {
              NAV.filter((n) => n.header).map((n) => (
                <li>
                  <a href={hrefFor(localePath(locale, n.path))} aria-current={current(n.path)} hreflang={toHreflang(n.path)}>
                    {navLabel(locale, n.path, n.label)}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="lang-row" role="group" aria-labelledby="lang-row-label">
          <p class="lang-row-label" id="lang-row-label">{t.language.label}</p>
          <ul>
            {
              targets.map((target) => (
                <li>
                  <a
                    href={hrefFor(target.path)}
                    lang={target.info.hreflang}
                    hreflang={target.info.hreflang}
                    aria-current={target.code === locale ? "true" : undefined}
                  >
                    {target.info.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </details>

    <span class="seam" aria-hidden="true"></span>

    <details class="lang" data-lang-switch>
      <summary class="lang-toggle">
        <svg class="globe" viewBox="0 0 8 7" width="16" height="14" aria-hidden="true" focusable="false" shape-rendering="crispEdges"><path fill="currentColor" d={globe} /></svg>
        <span class="lang-code" aria-hidden="true">{info.short}</span>
        <span class="sr-only">{t.language.label}: {info.name}</span>
      </summary>
      <ul class="lang-list" aria-label={t.language.switchLabel}>
        {
          targets.map((target) => (
            <li>
              <a
                href={hrefFor(target.path)}
                lang={target.info.hreflang}
                hreflang={target.info.hreflang}
                aria-current={target.code === locale ? "true" : undefined}
              >
                <span class="lang-name">{target.info.name}</span>
                <span class="lang-short" aria-hidden="true">{target.info.short}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </details>

    {
      hasRelease ? (
        <Button href={hrefFor(localePath(locale, "download/"))} class="action js-download">
          <DownloadLabel />
        </Button>
      ) : (
        <Button href={PRIMARY_ACTION.href} external class="action">{locale === "en" ? PRIMARY_ACTION.label : t.primaryAction}</Button>
      )
    }
  </div>
  </div>
</header>

{hasRelease && <script type="application/json" id="cp-releases" set:html={scriptData} />}
{hasRelease && <script>import "../lib/download-client";</script>}
{LOCALES.length > 1 && <script>import "../lib/lang-switch";</script>}

<style>
  /*
   * One row: the lockup (the mark and the name, one unit), the links, a seam, the action. Slim (the bar is
   * --header-h tall), aligned with the content column below. The current page is marked by a pixel block
   * on the bar's bottom edge, like the app's selected tab; hovering a link steps a quieter block in.
   * Once the page has scrolled under it, the header draws its outline and a hard shadow (scroll-state).
   */
  .header {
    view-transition-name: site-header;
  }
  .header[data-sticky] {
    position: sticky;
    top: 0;
    z-index: 40;
    container-type: scroll-state;
  }
  .chrome {
    background: var(--bg-toolbar);
    color: var(--fg-primary);
    border-bottom: var(--border-width) solid transparent;
    box-shadow: inset 0 calc(-1 * var(--bevel-size-sm)) 0 var(--bevel-shadow);
    transition:
      border-color var(--motion-quick) steps(1, end),
      box-shadow var(--motion-quick) steps(1, end);
  }
  /* the home page's header never sticks: it keeps its outline */
  .header:not([data-sticky]) .chrome {
    border-bottom-color: var(--border-outline);
  }
  @container scroll-state(stuck: top) {
    .chrome {
      border-bottom-color: var(--border-outline);
      box-shadow:
        inset 0 calc(-1 * var(--bevel-size-sm)) 0 var(--bevel-shadow),
        0 4px 0 color-mix(in srgb, var(--border-shadow) 70%, transparent);
    }
  }
  /* a browser that cannot tell when it is stuck draws the outline all the time */
  @supports not (container-type: scroll-state) {
    .chrome {
      border-bottom-color: var(--border-outline);
    }
  }
  .bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-md) var(--r1);
    width: min(100% - 2 * var(--gutter), var(--content-max));
    min-height: calc(var(--header-h) - var(--border-width));
    margin-inline: auto;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 2.75rem;
    margin-right: auto;
    font-family: var(--font-pixel);
    font-size: var(--font-size-lg);
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  .mark {
    display: block;
    image-rendering: pixelated;
    /* the mark sits in the name's own outline, so the two read as one */
    box-shadow: 2px 2px 0 var(--border-outline);
  }
  .brand:hover .name {
    color: var(--accent-primary-hover);
  }
  .nav ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-pixel);
    font-weight: 600;
  }
  .nav a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-sm);
    text-decoration: none;
    background: none;
    transition: color var(--motion-quick) steps(1, end);
  }
  .nav a:hover {
    color: var(--accent-primary-hover);
  }
  .nav a[aria-current] {
    color: var(--fg-primary);
  }
  /* the block under a link: hidden, stepped in on hover (quiet), solid accent for the current page */
  .nav a::after {
    content: "";
    position: absolute;
    left: var(--space-sm);
    right: var(--space-sm);
    bottom: 0;
    height: 4px;
    background: var(--border-highlight);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 120ms steps(3, end);
  }
  .nav a:hover::after {
    transform: scaleX(1);
  }
  .nav a[aria-current]::after {
    background: var(--accent-primary);
    box-shadow: 0 0 0 var(--hairline) var(--border-outline);
    transform: none;
  }
  .seam {
    display: none;
  }
  /* the action sits in the row: the links' height, after a seam */
  .bar > :global(.action) {
    min-height: 2.5rem;
    padding-block: var(--space-xs);
  }
  /* the menu: a disclosure on a phone, the bar's own items from 62.5rem up */
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: var(--space-xs) var(--space-md);
    background: var(--bg-panel);
    border: var(--border-width) solid var(--border-outline);
    box-shadow: var(--focus-halo), var(--shadow-bevel);
    font-family: var(--font-pixel);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .menu-toggle:active {
    box-shadow: var(--focus-halo), var(--shadow-bevel-pressed);
  }
  .menu-toggle::-webkit-details-marker {
    display: none;
  }
  .menu-toggle::after {
    content: "\25BE";
    margin-left: var(--space-sm);
  }
  .menu[open] .menu-toggle::after {
    content: "\25B4";
  }
  .menu-body {
    position: absolute;
    z-index: 50;
    left: calc(-1 * var(--gutter));
    right: calc(-1 * var(--gutter));
    top: calc(100% + var(--border-width));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    padding: var(--space-md) var(--gutter);
    background: var(--bg-toolbar);
    border-bottom: var(--border-width) solid var(--border-outline);
    box-shadow: var(--shadow-panel);
  }
  .menu-body .nav ul {
    flex-direction: column;
    gap: var(--space-xs);
  }
  .menu-body .nav a {
    padding-inline: 0;
  }
  .menu-body .nav a::after {
    left: 0;
    right: auto;
    width: 2rem;
    bottom: var(--space-xs);
  }
  /*
   * The language switch (DEC-311). On a phone it is the last row of the menu: a label, then each language as a
   * link, the current one muted. From 62.5rem it is a button after the seam ("EN" and a globe, like the
   * Menu button) that opens a list on a click; nothing here is hover only.
   */
  .lang {
    display: none;
    position: relative;
  }
  .lang-row {
    align-self: stretch;
    margin-top: var(--space-xs);
    padding-top: var(--space-md);
    border-top: var(--border-width) solid var(--border-muted);
  }
  .lang-row-label {
    margin: 0 0 var(--space-xs);
    font-family: var(--font-pixel);
    font-weight: 600;
    font-size: var(--font-size-sm);
    font-variant-ligatures: none;
  }
  .lang-row ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--r1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lang-row a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
  .lang-row a[aria-current] {
    color: var(--fg-muted);
    text-decoration: none;
  }
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 2.5rem;
    padding: var(--space-xs) var(--space-md);
    background: var(--bg-panel);
    border: var(--border-width) solid var(--border-outline);
    box-shadow: var(--focus-halo), var(--shadow-bevel);
    font-family: var(--font-pixel);
    font-weight: 600;
    font-variant-ligatures: none;
    cursor: pointer;
    list-style: none;
  }
  .lang-toggle::-webkit-details-marker {
    display: none;
  }
  .lang-toggle::after {
    content: "\25BE";
    margin-left: var(--space-xs);
  }
  .lang[open] .lang-toggle::after {
    content: "\25B4";
  }
  .lang-toggle:active {
    box-shadow: var(--focus-halo), var(--shadow-bevel-pressed);
  }
  .lang[open] .lang-toggle {
    border-color: var(--accent-primary);
  }
  .globe {
    display: block;
    flex: none;
  }
  .lang-list {
    position: absolute;
    z-index: 60;
    top: calc(100% + var(--space-xs));
    right: 0;
    min-width: 15rem;
    margin: 0;
    padding: var(--space-xs);
    list-style: none;
    background: var(--bg-panel);
    border: var(--border-width-heavy) solid var(--border-outline);
    box-shadow: var(--shadow-panel);
  }
  .lang-list li {
    margin: 0;
  }
  .lang-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: 2.75rem;
    padding-inline: var(--space-md);
    text-decoration: none;
  }
  .lang-list a:hover {
    background: var(--bg-panel-alt);
  }
  .lang-list a[aria-current] {
    background: var(--bg-selected);
  }
  .lang-short {
    color: var(--fg-muted);
    font-size: var(--font-size-sm);
  }
  /* a phone: the lockup, the Menu and the action still fit one row; on the narrowest screens the action wraps */
  @media (max-width: 39.99rem) {
    .bar {
      flex-wrap: wrap;
      gap: var(--space-xs);
      padding-block: var(--space-xs);
    }
    .brand {
      gap: var(--space-xs);
      font-size: 1rem;
    }
    .menu-toggle {
      padding-inline: var(--space-sm);
    }
    .menu-toggle::after {
      margin-left: var(--space-xs);
    }
    .bar > :global(.action) {
      min-height: 2.75rem;
      padding-inline: 0.4rem;
      font-size: var(--font-size-sm);
      white-space: nowrap;
    }
    /* "Download for Windows" does not fit beside the mark and the Menu, so a phone's header says
       "Download"; the download page names the system */
    .bar > :global(.action .dl-labels > span:not([data-l="neutral"])) {
      display: none;
    }
    .bar > :global(.action .dl-labels > [data-l="neutral"]) {
      visibility: visible;
    }
  }
  /* the home page has its own call to action: on a phone the bar is the mark and the menu */
  @media (max-width: 62.49rem) {
    .bar[data-home="true"] :global(.action) {
      display: none;
    }
  }
  @media (min-width: 62.5rem) {
    .menu,
    .menu-body {
      display: contents;
    }
    .menu-toggle {
      display: none;
    }
    /* a closed <details> hides its content; the browsers that can show it always do, on a wide screen */
    .menu::details-content {
      content-visibility: visible;
      display: contents;
    }
    .menu-body .nav ul {
      flex-direction: row;
      gap: calc(var(--space-md) * 1.2);
    }
    .menu-body .nav a {
      min-height: calc(var(--header-h) - var(--border-width));
      padding-inline: var(--space-sm);
      font-size: 1.15rem;
    }
    .menu-body .nav a::after {
      left: var(--space-sm);
      right: var(--space-sm);
      width: auto;
      bottom: calc(-1 * var(--border-width));
    }
    .lang {
      display: block;
    }
    .lang-row {
      display: none;
    }
    .seam {
      display: block;
      align-self: center;
      width: var(--border-width);
      height: 1.75rem;
      background: var(--border-outline);
      box-shadow: var(--hairline) 0 0 var(--border-muted);
    }
  }
</style>
