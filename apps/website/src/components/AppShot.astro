---
/**
 * A picture of the app (SITE-06). SITE-04 captures the real screenshots; until then each slot is a
 * clearly labelled placeholder of the right size (the app's default window, 1280 x 800), so the page
 * is laid out as it will be and never shows a made-up screenshot. The slot is a placeholder if and only
 * if src/lib/app-shots.ts finds no file for its id: adding `src/assets/app/<id>-<theme>.png` is the
 * whole change. The caption says what the picture shows, so the picture itself has empty alt text and
 * a screen reader hears it once.
 *
 * `bare` is for the copy that fades in over the opening scene: no caption,
 * and hidden from assistive technology, because the slot below the scene is the one that is read.
 */
import type { ImageMetadata } from "astro";
import { APP_SHOTS, type AppShotId } from "../data/home";
import { shotImages, type ShotImage } from "../lib/app-shots";
import Img from "./Img.astro";

interface Props {
  id: AppShotId;
  class?: string;
  bare?: boolean;
  /** For tests: the pictures to show instead of the ones the repository holds. */
  images?: ShotImage[];
}
const { id, class: className, bare = false, images } = Astro.props;
const shot = APP_SHOTS[id];
const found = images ?? shotImages(id);
const ratio = `aspect-ratio: ${shot.width} / ${shot.height}`;
const placeholder = found.length === 0;
---

<figure
  class:list={["shot", className]}
  data-app-shot={id}
  data-placeholder={placeholder ? "true" : undefined}
  aria-hidden={bare ? "true" : undefined}
>
  {
    placeholder ? (
      <div class="frame slot" data-slot-frame style={ratio}>
        <div class="plate">
          <p class="tag">Screenshot placeholder</p>
          <p class="name">{shot.label}</p>
          <p class="size">{shot.width} by {shot.height}, the app's own size</p>
        </div>
      </div>
    ) : (
      found.map(({ theme, image }) => (
        <div class="frame" data-slot-frame data-shot-theme={theme} style={ratio}>
          <Img
            src={image as ImageMetadata}
            alt=""
            decorative
            width={shot.width}
            height={shot.height}
            sizes="(min-width: 72rem) 70rem, 100vw"
            loading="lazy"
          />
        </div>
      ))
    )
  }
  {
    !bare && (
      <figcaption>
        {placeholder
          ? `Screenshot placeholder: the real picture is coming. It will show ${shot.alt.charAt(0).toLowerCase()}${shot.alt.slice(1)}`
          : shot.alt}
      </figcaption>
    )
  }
</figure>

<style>
  .shot {
    margin: 0;
  }
  .frame {
    position: relative;
    width: 100%;
    border: var(--border-width) solid var(--border-outline);
    background: var(--bg-panel);
    box-shadow: var(--shadow-panel);
    overflow: hidden;
  }
  /* one picture per theme; only the page's theme shows (a hidden one is lazy and never fetched) */
  .frame[data-shot-theme] {
    display: none;
  }
  :global(:root[data-theme="neoDark"]) .frame[data-shot-theme="neoDark"],
  :global(:root[data-theme="retro16"]) .frame[data-shot-theme="retro16"],
  :global(:root[data-theme="qtEvolved"]) .frame[data-shot-theme="qtEvolved"],
  :global(:root[data-theme="clubNeon"]) .frame[data-shot-theme="clubNeon"],
  :global(:root[data-theme="mutedPro"]) .frame[data-shot-theme="mutedPro"] {
    display: block;
  }
  .frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* hard diagonal stripes in the theme's own panel colors: a slot, plainly not a screenshot */
  .slot {
    display: grid;
    place-items: center;
    background: repeating-linear-gradient(135deg, var(--bg-panel) 0 12px, var(--bg-panel-alt) 12px 24px);
  }
  .plate {
    max-width: min(90%, 22rem);
    padding: var(--space-md) var(--space-lg);
    background: var(--bg-panel);
    border: var(--border-width) solid var(--border-outline);
    box-shadow: var(--shadow-bevel-panel);
    color: var(--fg-primary);
    text-align: center;
  }
  .plate p {
    margin: 0;
  }
  .tag {
    font-family: var(--font-pixel);
    font-size: var(--font-size-sm);
    font-weight: 600;
    text-transform: uppercase;
  }
  .name {
    margin-block: var(--space-xs) !important;
    font-family: var(--font-pixel);
    font-size: var(--font-size-lg);
    font-weight: 700;
  }
  .size {
    font-size: var(--font-size-sm);
  }
  figcaption {
    margin-top: var(--space-sm);
    color: var(--fg-muted);
    font-size: var(--font-size-sm);
  }
</style>
