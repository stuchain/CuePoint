---
/**
 * The footer: the lockup and one line about CuePoint, then the site's pages in three groups (Product,
 * Help, Legal) from src/data/nav.ts, so a new page is filed where a visitor looks for it.
 */
import { EXTERNAL_NAV, FOOTER_GROUPS, NAV } from "../data/nav";
import { PUBLISHER, SITE_NAME } from "../data/site";
import { hrefFor } from "../lib/url";
import mark from "../assets/mark/mark-32.svg";

const year = new Date().getFullYear();
// TODO(DEC-144): the publisher is the user, as an individual; PUBLISHER is a placeholder name.
const groups = FOOTER_GROUPS.map((g) => ({
  ...g,
  links: [
    ...NAV.filter((n) => n.group === g.id).map((n) => ({ label: n.label, href: hrefFor(n.path), external: false })),
    ...EXTERNAL_NAV.filter((n) => n.group === g.id).map((n) => ({ label: n.label, href: n.href, external: true })),
  ],
}));
---

<footer class="footer">
  <div class="inner">
    <div class="about">
      <a class="brand" href={hrefFor("")}>
        <img src={mark.src} width="32" height="32" alt="" />
        <span>{SITE_NAME}</span>
      </a>
      <p>A free desktop app that cleans up your Rekordbox library.</p>
    </div>
    <nav class="groups" aria-label="Footer">
      {
        groups.map((g) => (
          <div class="group" data-footer-group={g.id}>
            <h2 class="label" id={`footer-${g.id}`}>{g.label}</h2>
            <ul aria-labelledby={`footer-${g.id}`}>
              {g.links.map((l) => (
                <li>
                  <a href={l.href} rel={l.external ? "noopener noreferrer" : undefined}>
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
    <p class="legal">© {year} {PUBLISHER}. {SITE_NAME} is free software for DJs.</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--r3);
    background: var(--bg-toolbar);
    color: var(--fg-primary);
    border-top: var(--border-width-heavy) solid var(--border-outline);
    box-shadow: inset 0 var(--border-width) 0 var(--border-highlight);
  }
  .inner {
    display: grid;
    gap: var(--r2) var(--r3);
    width: min(100% - 2 * var(--gutter), var(--content-max));
    margin-inline: auto;
    padding-block: var(--r2);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 2.75rem;
    font-family: var(--font-pixel);
    font-size: var(--font-size-lg);
    font-weight: 700;
    text-decoration: none;
  }
  .brand img {
    image-rendering: pixelated;
    box-shadow: 2px 2px 0 var(--border-outline);
  }
  .brand:hover span {
    color: var(--accent-primary-hover);
  }
  .about p {
    max-width: 18rem;
    margin: var(--space-sm) 0 0;
  }
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--r2);
  }
  /* a group's name is a heading for its list, sized as a label: the page's own headings stay above it */
  .label {
    margin: 0 0 var(--space-sm);
    font-size: var(--font-size-md);
    line-height: 1.3;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li a {
    display: inline-block;
    padding-block: var(--space-xs);
  }
  .legal {
    grid-column: 1 / -1;
    margin: 0;
    padding-top: var(--r1);
    border-top: var(--border-width) solid var(--border-outline);
    box-shadow: inset 0 var(--border-width) 0 var(--border-muted);
    font-size: var(--font-size-sm);
  }
  @media (min-width: 48rem) {
    .inner {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
  }
</style>
