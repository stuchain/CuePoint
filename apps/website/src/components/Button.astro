---
import type { ButtonProps } from "./Button.types";

type Props = ButtonProps;

const props = Astro.props as ButtonProps;
const variant = props.variant ?? "primary";
const className = props.class;
---

{
  props.href !== undefined ? (
    <a
      class:list={["btn", className]}
      data-variant={variant}
      href={props.href}
      rel={props.external ? "noopener noreferrer" : undefined}
    >
      <slot />
    </a>
  ) : (
    <button
      class:list={["btn", className]}
      data-variant={variant}
      type={props.type ?? "button"}
      disabled={props.disabled}
    >
      <slot />
    </button>
  )
}

<style is:global>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    min-height: 2.75rem;
    padding: var(--space-sm) var(--space-lg);
    border: var(--border-width) solid var(--border-outline);
    border-radius: 0;
    font-family: var(--font-pixel);
    font-size: var(--font-size-md);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    box-shadow: var(--focus-halo), var(--shadow-bevel), var(--shadow-badge);
  }
  /* Black on the accent is >= 4.5:1 in all five themes; --fg-inverse is not (Neo Dark 4.06). */
  .btn[data-variant="primary"] {
    background: var(--accent-primary);
    color: var(--border-outline);
  }
  .btn[data-variant="secondary"] {
    background: var(--accent-secondary);
    color: var(--fg-primary);
  }
  /*
   * Like a key of the app: on hover it lifts 2px and its hard shadow grows by as much, so the corner stays
   * put; pressed, it goes down onto the page and the shadow is gone. Two steps, 80 ms: answered, not animated.
   */
  .btn {
    transition:
      translate var(--motion-quick) steps(2, end),
      box-shadow var(--motion-quick) steps(2, end),
      background-color var(--motion-quick) steps(1, end);
  }
  .btn:hover {
    translate: -2px -2px;
    box-shadow: var(--focus-halo), var(--shadow-bevel), 4px 4px 0 var(--border-shadow);
  }
  .btn[data-variant="primary"]:hover {
    background: var(--accent-primary-hover);
  }
  .btn[data-variant="secondary"]:hover {
    background: var(--accent-secondary-hover);
  }
  .btn:active {
    translate: 2px 2px;
    box-shadow: var(--focus-halo), var(--shadow-bevel-pressed);
  }
  .btn:disabled,
  .btn:disabled:hover,
  .btn:disabled:active {
    translate: none;
    box-shadow: var(--focus-halo), var(--shadow-bevel);
  }
  @media (prefers-reduced-motion: reduce) {
    .btn:hover {
      translate: none;
    }
    .btn:active {
      translate: none;
    }
  }
  .btn:disabled {
    background: var(--bg-panel-alt);
    color: var(--fg-primary);
    opacity: 0.6;
    cursor: not-allowed;
    filter: none;
  }
</style>
