---
/**
 * The inside of a Download button (SITE-07). Every label the button can show is in the markup,
 * stacked in one grid cell, so the button always has room for the longest and detection never
 * changes its width. Only the neutral "Download" is visible until the script (lib/download-client.ts)
 * puts the detected system on the link as `data-system`; the others are `visibility: hidden`, which
 * also keeps them out of the accessibility tree.
 */
import { localeFromUrl } from "../i18n/paths";
import { ui } from "../i18n/ui";

// the labels are the page's language (DEC-312); the button's width still holds the longest of them
const t = ui(localeFromUrl(Astro.url)).downloadLabel;
---

<span class="dl-labels">
  <span data-l="neutral">{t.neutral}</span>
  <span data-l="windows">{t.windows}</span>
  <span data-l="macos">{t.macos}</span>
  <span data-l="linux">{t.linux}</span>
</span>

<style is:global>
  .dl-labels {
    display: inline-grid;
  }
  .dl-labels > span {
    grid-area: 1 / 1;
    visibility: hidden;
    text-align: center;
  }
  .dl-labels > [data-l="neutral"] {
    visibility: visible;
  }
  .js-download[data-system] .dl-labels > span {
    visibility: hidden;
  }
  .js-download[data-system="windows"] .dl-labels > [data-l="windows"],
  .js-download[data-system="macos"] .dl-labels > [data-l="macos"],
  .js-download[data-system="linux"] .dl-labels > [data-l="linux"] {
    visibility: visible;
  }
</style>
