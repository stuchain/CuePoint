---
// A 3D scene (SITE-05). The page is HTML and a picture first: the scene's still, rendered from the
// scene itself in each theme, is an <img> with a fixed width and height. The canvas is added over
// it only if and when the 3D starts (src/three/boot.ts), and fades in over it, so with no WebGL, no GPU,
// reduced motion, saveData, a small device or a slow first two seconds, the still is the scene. The
// canvas is aria-hidden: say what the scene shows in the text next to it.
//
// A still is the scene's own render target (320 x 180, a few KB), served as it is: no resizing and no
// AVIF or WebP, so its pixels stay the scene's pixels. Only the default theme's still is ever loaded
// eagerly, and only for a scene at the top of the page (`priority`); the others are lazy images in
// elements that are display:none, so a browser never fetches them.
//
// The home page (SITE-06) adds:
//   `fill`       the scene covers its container (a full screen): no frame, the still cropped to cover, and
//                for a scene with tall stills a 9:16 one where the screen is upright;
//   `frames`     the scene's other still frames, stacked over the resting one: where 3D does not run the
//                page shows the frame of the step being read (data-frame on the host, set by the page);
//   `autostart`  the scene starts once the page is idle, without waiting for the visitor to do something;
//   `bare`       no frame: the scene stands on the page's own background (the props beside the sections).
import { DEFAULT_THEME, THEMES } from "../lib/themes";
import type { SceneName } from "../three/scenes";
import { STILL_HEIGHT, STILL_WIDTH, TALL_HEIGHT, TALL_WIDTH } from "../three/still-size";

interface Props {
  /** A scene in src/three/scenes/. */
  name: SceneName;
  /** The still's description, when the page's own text does not already say what the scene shows. */
  alt?: string;
  /** A scene at the top of the page: its default-theme still loads first (it can be the largest paint). */
  priority?: boolean;
  /**
   * A selector for a taller section whose scroll drives the scene, for a scene that sticks while that
   * section passes (the home page's opening). Left out, the scene's own travel across the screen drives it.
   */
  trigger?: string;
  /** With `trigger`: where the section's top and bottom count on the screen, "top top,bottom bottom" by default. */
  range?: string;
  /** Seconds the scene takes to catch up with the scroll (a glide); left out, it follows the scroll exactly. */
  scrub?: number;
  fill?: boolean;
  frames?: readonly string[];
  autostart?: boolean;
  bare?: boolean;
  class?: string;
}

const { name, alt = "", priority = false, trigger, range, scrub, fill = false, frames = [], autostart = false, bare = false, class: className } = Astro.props;

const files = import.meta.glob<string>("../assets/stills/*.png", { eager: true, query: "?url&no-inline", import: "default" });
const file = (stem: string, theme: string) => files[`../assets/stills/${stem}-${theme}.png`];
const stills = THEMES.map((theme) => {
  const src = file(name, theme.id);
  if (!src) throw new Error(`Scene "${name}" has no still for ${theme.id}: run \`npm run stills\``);
  const frameSrcs = frames.map((frame) => {
    const wide = file(`${name}-${frame}`, theme.id);
    if (!wide) throw new Error(`Scene "${name}" has no "${frame}" still for ${theme.id}: run \`npm run stills\``);
    return { frame, wide, tall: fill ? file(`${name}-${frame}-tall`, theme.id) : undefined };
  });
  return { theme: theme.id, src, tall: fill ? file(`${name}-tall`, theme.id) : undefined, frames: frameSrcs };
});
// an upright screen gets the tall still, where the scene has one
const UPRIGHT = "(max-aspect-ratio: 4/5)";
---

<div
  class:list={["scene", className]}
  data-scene={name}
  data-scene-state="still"
  data-scene-trigger={trigger}
  data-scene-range={range}
  data-scene-scrub={scrub}
  data-scene-autostart={autostart ? "" : undefined}
  data-fill={fill ? "true" : undefined}
  data-bare={bare || fill ? "true" : undefined}
  data-frame={frames.length > 0 ? "rest" : undefined}
  style={`--scene-ratio: ${STILL_WIDTH} / ${STILL_HEIGHT}`}
>
  {
    stills.map(({ theme, src, tall }) => {
      const first = priority && theme === DEFAULT_THEME;
      return (
        <span class="still" data-still-theme={theme}>
          <picture>
            {tall && <source media={UPRIGHT} srcset={tall} width={TALL_WIDTH} height={TALL_HEIGHT} />}
            <img
              src={src}
              alt={alt}
              width={STILL_WIDTH}
              height={STILL_HEIGHT}
              loading={first ? "eager" : "lazy"}
              fetchpriority={first ? "high" : "auto"}
              decoding="async"
            />
          </picture>
        </span>
      );
    })
  }
  {
    frames.length > 0 &&
      stills.map(({ theme, frames: list }) => (
        <span class="flip" data-still-theme={theme} aria-hidden="true">
          {list.map(({ frame, wide, tall }) => (
            <picture data-frame-still={frame}>
              {tall && <source media={UPRIGHT} srcset={tall} width={TALL_WIDTH} height={TALL_HEIGHT} />}
              <img src={wide} alt="" width={STILL_WIDTH} height={STILL_HEIGHT} loading="lazy" decoding="async" />
            </picture>
          ))}
        </span>
      ))
  }
  <div class="layer" data-scene-layer aria-hidden="true"></div>
</div>

<script>
  import { boot } from "../three/boot";
  boot();
</script>

<style>
  .scene {
    position: relative;
    width: 100%;
    aspect-ratio: var(--scene-ratio);
    overflow: hidden;
    background: var(--bg-app);
    border: var(--border-width) solid var(--border-outline);
    box-shadow: var(--shadow-panel);
  }
  .scene[data-bare="true"] {
    border: 0;
    box-shadow: none;
  }
  .scene[data-fill="true"] {
    position: absolute;
    inset: 0;
    width: auto;
    aspect-ratio: auto;
  }
  .still,
  .flip {
    display: none;
    position: absolute;
    inset: 0;
  }
  :global(:root[data-theme="neoDark"]) [data-still-theme="neoDark"],
  :global(:root[data-theme="retro16"]) [data-still-theme="retro16"],
  :global(:root[data-theme="qtEvolved"]) [data-still-theme="qtEvolved"],
  :global(:root[data-theme="clubNeon"]) [data-still-theme="clubNeon"],
  :global(:root[data-theme="mutedPro"]) [data-still-theme="mutedPro"] {
    display: block;
  }
  picture {
    display: contents;
  }
  .still img,
  .flip img {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }
  .scene[data-fill="true"] img {
    object-fit: cover;
  }
  /* the frames: stacked over the resting still, the one the page names shown */
  .flip img {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--motion-slow) steps(4);
  }
  .scene[data-frame="matched"] [data-frame-still="matched"] img,
  .scene[data-frame="ready"] [data-frame-still="ready"] img {
    opacity: 1;
  }
  .layer {
    position: absolute;
    inset: 0;
  }
  .layer :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    /* the live scene fades in over its still */
    transition: opacity 900ms ease-out;
  }
  @starting-style {
    .layer :global(canvas) {
      opacity: 0;
    }
  }
</style>
