---
/**
 * The shell both forms share (SITE-12, DEC-143): a plain HTML form that posts to Web3Forms (DEC-193), so
 * it works with no script. With script, form-client.ts adds the checks and sends it in the background,
 * then shows the thank-you page. The access key is public by design (DEC-193).
 *
 * Spam: a hidden `botcheck` field only a robot fills in, and a minimum fill time (form-client.ts). No puzzle.
 */
import { PUBLIC } from "../../site.config";
import { CONTACT_EMAIL, SITE_NAME, WEB3FORMS_ACCESS_KEY, WEB3FORMS_ENDPOINT } from "../data/site";
import { canonicalFor, hrefFor } from "../lib/url";
import Button from "./Button.astro";

interface Props {
  /** "contact" or "bug": which rules form-client.ts applies, and the name sent with the form-sent event. */
  kind: "contact" | "bug";
  /** The email's subject line when the form has no subject field of its own. */
  subject?: string;
  /** The thank-you page's path relative to the base. */
  thanks: string;
  /** The words of the send button. */
  send: string;
  /** What the person calls the thing sent, for the failure message: "message" or "report". */
  noun: string;
}
const { kind, subject, thanks, send, noun } = Astro.props;
---

<form
  class="form"
  method="post"
  action={WEB3FORMS_ENDPOINT}
  data-form={kind}
  data-thanks={hrefFor(thanks)}
  data-email={CONTACT_EMAIL}
  data-noun={noun}
>
  <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
  <!-- Absolute on purpose: Web3Forms redirects the no-script post to this address, and it must be a full URL.
       The script's own send deletes this field and goes to data-thanks instead. -->
  <input type="hidden" name="redirect" value={canonicalFor(thanks)} />
  <input type="hidden" name="from_name" value={`${SITE_NAME} website`} />
  {subject && <input type="hidden" name="subject" value={subject} />}
  <!-- the honeypot: hidden from people, so only a robot fills it in -->
  <div hidden>
    <label for="botcheck">Leave this empty</label>
    <input type="checkbox" id="botcheck" name="botcheck" tabindex="-1" autocomplete="off" />
  </div>

  <slot />

  <div class="summary" id="form-summary" aria-live="polite"></div>
  <div class="status" data-form-status role="alert" hidden></div>
  {!PUBLIC && <p class="preview-note">Preview build: this sends a real message.</p>}
  <Button type="submit">{send}</Button>
</form>

<script>
  import "../lib/form-client";
</script>

<style is:global>
  .form {
    max-width: 40rem;
  }
  .form .summary:empty {
    display: none;
  }
  .form .summary {
    margin-bottom: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    background: var(--bg-panel);
    border-left: calc(var(--border-width) * 3) solid var(--accent-danger);
  }
  .form .status {
    margin-bottom: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    background: var(--bg-panel);
    border-left: calc(var(--border-width) * 3) solid var(--accent-danger);
  }
  .form .preview-note {
    margin: 0 0 var(--space-sm);
    font-size: var(--font-size-sm);
    color: var(--fg-muted);
  }
  .form .status[hidden] {
    display: none;
  }
</style>
