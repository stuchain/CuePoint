.lighthouseci/
playwright-report/
test-results/
# the repository root ignores *.json; this one is config, not output
!lighthouserc.json
# the stills' record of what they were rendered from (SITE-05)
!src/assets/stills/manifest.json
# the app's pictures: each shot's size and alt draft beside the PNGs (SITE-04)
!src/assets/app/shots.json

# written by scripts/sync-assets.mjs from the app's icon files (run by build, check, test)
public/favicon.ico
public/icon.svg
public/icon-192.png
public/icon-512.png
public/apple-touch-icon.png

# SITE-07: the repository root ignores *.json; these are data the site and its tests read
!src/data/releases.json
!scripts/fixtures/*.json
!e2e/fixtures/*.json

# built by `npm run build:fixture` for e2e/download.spec.ts
dist-fixture/
dist-none/
